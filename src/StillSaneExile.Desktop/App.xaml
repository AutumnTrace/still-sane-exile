<Application x:Class="StillSaneExile.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The look borrows what players read every second in the game: its dark tooltip panels with thin
           bronze borders, small caps for headings, item names in their rarity colour, stats in the game's blue,
           and prices coloured like a loot filter label (ValueLabel, Tier* below). Corners are square.
           Colour rules: gold (Accent) is only for the search (tick boxes, numbers you can change, the stat
           count, the search button) and the chosen one of a few. Rarity colours only on item names.
           Contrast (docs/ACCESSIBILITY.md): every text colour, TextFaint included, reads at 4.5:1 or more on
           every surface up to Surface4 and on a ticked row; the empty tick box (Unchecked) at 3:1 or more on
           Surface3. -->
      <FontFamily x:Key="BodyFont">pack://application:,,,/StillSaneExile;component/Assets/Fonts/#Alegreya Sans</FontFamily>
      <FontFamily x:Key="CapsFont">pack://application:,,,/StillSaneExile;component/Assets/Fonts/#Alegreya Sans SC</FontFamily>

      <SolidColorBrush x:Key="Surface" Color="#0E0D0B" />
      <SolidColorBrush x:Key="Surface2" Color="#15130F" />
      <SolidColorBrush x:Key="Surface3" Color="#1C1914" />
      <SolidColorBrush x:Key="Surface4" Color="#2A241B" />
      <SolidColorBrush x:Key="Well" Color="#0A0908" />
      <SolidColorBrush x:Key="Line" Color="#2E281F" />
      <SolidColorBrush x:Key="RowLine" Color="#262019" />
      <SolidColorBrush x:Key="Edge" Color="#3A3226" />
      <SolidColorBrush x:Key="EdgeStrong" Color="#6B5638" />
      <SolidColorBrush x:Key="Unchecked" Color="#7A6A50" />
      <SolidColorBrush x:Key="Text" Color="#EDE6D6" />
      <SolidColorBrush x:Key="TextSoft" Color="#CFC6B3" />
      <SolidColorBrush x:Key="TextDim" Color="#ADA392" />
      <SolidColorBrush x:Key="TextOff" Color="#A39A88" />
      <SolidColorBrush x:Key="TextFaint" Color="#988D79" />
      <SolidColorBrush x:Key="Title" Color="#E8D9B5" />
      <SolidColorBrush x:Key="Accent" Color="#C9A867" />
      <SolidColorBrush x:Key="AccentHover" Color="#D8BC85" />
      <SolidColorBrush x:Key="OnAccent" Color="#1E1405" />
      <SolidColorBrush x:Key="AccentSoft" Color="#2A2116" />
      <SolidColorBrush x:Key="OnAccentSoft" Color="#F3E6C4" />
      <SolidColorBrush x:Key="AccentTint" Color="#21C9A867" />
      <SolidColorBrush x:Key="Link" Color="#D8BC85" />
      <SolidColorBrush x:Key="LinkHover" Color="#E8D9B5" />
      <SolidColorBrush x:Key="Warn" Color="#E8B49A" />
      <SolidColorBrush x:Key="Hint" Color="#E8C9A0" />
      <SolidColorBrush x:Key="DemoFill" Color="Transparent" />
      <SolidColorBrush x:Key="DemoEdge" Color="#6B5638" />
      <SolidColorBrush x:Key="Track" Color="#2E281F" />
      <SolidColorBrush x:Key="BarFill" Color="#CFC6B3" />
      <!-- Stats in the game's blue: bright and bold when searched, dimmer when not. -->
      <SolidColorBrush x:Key="StatOn" Color="#A8A8FF" />
      <SolidColorBrush x:Key="StatOff" Color="#8888C6" />
      <!-- Over the game: the panel, its bronze double border and its header strip. -->
      <SolidColorBrush x:Key="Panel" Color="#F80E0D0B" />
      <SolidColorBrush x:Key="PanelEdge" Color="#6B5638" />
      <SolidColorBrush x:Key="PanelInner" Color="#2E2619" />
      <SolidColorBrush x:Key="Strip" Color="#1A150E" />
      <SolidColorBrush x:Key="RarityMagic" Color="#9A9AFF" />
      <SolidColorBrush x:Key="RarityRare" Color="#FFFF77" />
      <SolidColorBrush x:Key="RarityUnique" Color="#D2803F" />
      <SolidColorBrush x:Key="RarityCurrency" Color="#C8BFA6" />
      <SolidColorBrush x:Key="RarityGem" Color="#1BA29B" />
      <!-- Price labels, loudest first: white and red, red, orange, amber, tan, dark. The orange label takes
           dark text: white on it reads at 3.7:1 only. -->
      <SolidColorBrush x:Key="TierSFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TierSInk" Color="#C8102E" />
      <SolidColorBrush x:Key="TierSEdge" Color="#C8102E" />
      <SolidColorBrush x:Key="TierAFill" Color="#C8102E" />
      <SolidColorBrush x:Key="TierAInk" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TierAEdge" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TierBFill" Color="#E05A1C" />
      <SolidColorBrush x:Key="TierBInk" Color="#1E1405" />
      <SolidColorBrush x:Key="TierBEdge" Color="#2A1206" />
      <SolidColorBrush x:Key="TierCFill" Color="#F2A93B" />
      <SolidColorBrush x:Key="TierCInk" Color="#1E1405" />
      <SolidColorBrush x:Key="TierCEdge" Color="#1E1405" />
      <SolidColorBrush x:Key="TierDFill" Color="#D9C3A0" />
      <SolidColorBrush x:Key="TierDInk" Color="#1E1405" />
      <SolidColorBrush x:Key="TierDEdge" Color="#1E1405" />
      <SolidColorBrush x:Key="TierEFill" Color="#1B1A18" />
      <SolidColorBrush x:Key="TierEInk" Color="#D9C3A0" />
      <SolidColorBrush x:Key="TierEEdge" Color="#6B5E48" />

      <v:VisibleWhenConverter x:Key="Vis" />
      <v:ActiveWhenEqualsConverter x:Key="Active" />
      <v:ShortCurrencyConverter x:Key="CurrencyName" />
      <v:PillActiveConverter x:Key="PillActive" />
      <v:RarityBrushConverter x:Key="RarityBrush" />
      <v:VisibleWhenEqualsConverter x:Key="VisibleWhen" />

      <!-- Buttons. One template; the styles change colours and the corner radius (v:Ui.Radius). Focus is a
           2 px ring in the text colour over the border: a border colour change alone is too faint on gold. -->
      <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Grid>
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{Binding (v:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <Border x:Name="ring" BorderBrush="{StaticResource Text}" BorderThickness="2" Visibility="Hidden" SnapsToDevicePixels="True" IsHitTestVisible="False"
                  CornerRadius="{Binding (v:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ring" Property="Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.45" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>

      <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="v:Ui.Radius" Value="2" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Style.Triggers>
          <!-- Tag = "active" marks the chosen one of a few (page, currency, card position...). Screen
               readers hear it as the item status "Selected"; the derived styles only change colours. -->
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

      <!-- The one strong button on a screen: the search, or finishing onboarding. Dark gold in a gold frame,
           like the game's own buttons. Everything else you can click is outlined. -->
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource CapsFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#3A2E1C" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Link}" />
        <Setter Property="Padding" Value="2,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource LinkHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- The keyboard focus ring for what has no template of its own to show focus: links inside text.
           WPF draws it only when focus arrives from the keyboard. -->
      <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="-2,-1" Stroke="{StaticResource Text}" StrokeThickness="1" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Links inside text (release notes), coloured like LinkButton. -->
      <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource Link}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource LinkHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Quiet text action, e.g. "reset". -->
      <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="0,8" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Header destinations. Tag = "active" marks the current page. -->
      <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="Padding" Value="14,0" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
          </Trigger>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface4}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A choice among a few (profile, display currency). Tag = "active" marks the chosen one: dark gold in
           a gold frame. -->
      <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- One of a row of small choices ("start at", "prices in"): outlined, the chosen one dark gold. -->
      <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource CapsFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,0" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentSoft}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="#15120D" />
      </Style>

      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="v:Ui.Radius" Value="2" />
        <!-- The ring while typing, 2 px over the border. A box whose border is already the accent switches
             it to Text. -->
        <Setter Property="v:Ui.FocusBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Grid>
                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding (v:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True">
                  <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <Border x:Name="ring" BorderBrush="{Binding (v:Ui.FocusBrush), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="2" Visibility="Hidden"
                        CornerRadius="{Binding (v:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Tick box: a gold square when ticked, an empty bronze-grey one when not. Focus draws a ring around
           the box. -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ring" Width="23" Height="23" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource Text}" VerticalAlignment="Center" Visibility="Hidden" SnapsToDevicePixels="True" />
                <Border x:Name="box" Width="17" Height="17" BorderThickness="1.5" BorderBrush="{StaticResource Unchecked}" Background="Transparent" VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <Path x:Name="tick" Data="M 3.4,8.2 L 6.4,11.2 L 12.4,4.8" Stroke="{StaticResource OnAccent}" StrokeThickness="2.2"
                        Margin="-1.5" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                  <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                  <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Thin dark scroll bars. Clicking the bar above or below the thumb pages, as in Windows. -->
      <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="t" Background="{StaticResource Edge}" Margin="2" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="t" Property="Background" Value="{StaticResource EdgeStrong}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="t" Property="Background" Value="{StaticResource EdgeStrong}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The empty part of a scroll bar's track: clickable, never a tab stop. -->
      <Style x:Key="TrackPart" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Command="{x:Static ScrollBar.PageUpCommand}" AutomationProperties.Name="Page up" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackPart}" Command="{x:Static ScrollBar.PageDownCommand}" AutomationProperties.Name="Page down" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource TrackPart}" Command="{x:Static ScrollBar.PageLeftCommand}" AutomationProperties.Name="Page left" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource TrackPart}" Command="{x:Static ScrollBar.PageRightCommand}" AutomationProperties.Name="Page right" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Every scroll area: the dark bars above, and a clear corner where the system one would draw a
           light grey square when both bars show. Never a focus stop of its own: the keys scroll it from
           whatever inside has focus, and Tab brings that into view. -->
      <Style TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollViewer">
              <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow" AutomationProperties.AutomationId="VerticalScrollBar"
                           Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow" AutomationProperties.AutomationId="HorizontalScrollBar"
                           Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A list of things that is not itself a control (rows, choices, notes): never a focus stop with
           nothing to show for it. The buttons and boxes in it still are. -->
      <Style TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
      </Style>

      <!-- Slider (the quick price card's size): a dark track that fills up to a light thumb, in the
           roll bars' colours, with the buttons' focus outline. Background colours the track part. -->
      <Style x:Key="SliderPart" TargetType="RepeatButton" BasedOn="{StaticResource TrackPart}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Grid Background="Transparent">
                <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Ellipse x:Name="e" Width="16" Height="16" Fill="{StaticResource TextSoft}" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="e" Property="Fill" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="e" Property="Fill" Value="{StaticResource Text}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="8,0" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" VerticalAlignment="Center">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderPart}" Background="{StaticResource BarFill}" Command="{x:Static Slider.DecreaseLarge}" AutomationProperties.Name="Decrease" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SliderPart}" Background="{StaticResource Unchecked}" Command="{x:Static Slider.IncreaseLarge}" AutomationProperties.Name="Increase" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumb}" />
                  </Track.Thumb>
                </Track>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- "Details": the fine print under a setting, folded away until asked for. The header is a link-coloured
           toggle with a chevron; Space or Enter opens it, and screen readers hear it expand and collapse. -->
      <Style x:Key="Details" TargetType="Expander">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <StackPanel>
                <ToggleButton x:Name="toggle" Content="{TemplateBinding Header}" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="3,2,5,2" Margin="-4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Path x:Name="chevron" Data="M 1,1 L 5,5 L 1,9" Width="7" Height="10" Stroke="{StaticResource Link}" StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5" />
                          <ContentPresenter x:Name="text" TextElement.Foreground="{StaticResource Link}" TextElement.FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="90" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="text" Property="TextElement.Foreground" Value="{StaticResource LinkHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="body" Visibility="Collapsed" Margin="0,6,0,0" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="body" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The fine print inside Details. -->
      <Style x:Key="FinePrint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <!-- Small label above a list ("CHECKED THIS SESSION"). -->
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="4,14,0,6" />
      </Style>

      <!-- Headings and labels in small caps, like the game's own panels. -->
      <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CapsFont}" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>

      <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
        <Setter Property="FontSize" Value="17" />
      </Style>

      <Style x:Key="CardLead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Margin" Value="0,0,0,20" />
      </Style>

      <!-- "demo" in small gold caps in a thin bronze frame: there, but never louder than a price. -->
      <Style x:Key="DemoBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DemoFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource DemoEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource CapsFont}" />
        <Setter Property="ToolTip" Value="Every price, range and listing in the demo is made up for practice." />
      </Style>

      <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="BorderBrush" Value="#4A3E2C" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- A count that belongs to the search ("3 / 7 stats"): gold small caps, no pill. -->
      <Style x:Key="AccentPill" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource CapsFont}" />
        <Setter Property="TextElement.FontWeight" Value="ExtraBold" />
      </Style>

      <!-- Over the game: a dark see-through panel in a thin bronze double border, like the game's tooltips.
           Square corners, no glow. -->
      <Style x:Key="GamePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <!-- Just inside GamePanel's edge: the darker inner line of the double border. -->
      <Style x:Key="GamePanelInner" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PanelInner}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <!-- The panel's header strip, with the item name centred under it. -->
      <Style x:Key="GameStrip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Strip}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>

      <!-- Numbered step marker (onboarding) and guide pin. -->
      <Style x:Key="StepDot" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.FontSize" Value="15.5" />
      </Style>
      <Style x:Key="GuidePin" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource Text}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Surface}" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.FontSize" Value="13.5" />
      </Style>

      <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="ListBoxItem">
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Padding="10,9" CornerRadius="2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,0,0,2">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource Surface4}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <DataTemplate DataType="{x:Type vm:InspectViewModel}">
        <v:InspectView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <v:PlaceholderView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CraftViewModel}">
        <v:CraftView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:GuideViewModel}">
        <v:GuideView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
