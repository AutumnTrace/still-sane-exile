<Application x:Class="StillSaneExile.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Neutral charcoal, warm white type, one accent, one distinct warning color + icon. -->
      <SolidColorBrush x:Key="Surface" Color="#1A1B1E" />
      <SolidColorBrush x:Key="Surface2" Color="#222428" />
      <SolidColorBrush x:Key="Surface3" Color="#2C2E33" />
      <SolidColorBrush x:Key="Line" Color="#3A3C42" />
      <SolidColorBrush x:Key="Text" Color="#F2ECE2" />
      <SolidColorBrush x:Key="TextDim" Color="#B5AEA2" />
      <SolidColorBrush x:Key="TextFaint" Color="#857F75" />
      <SolidColorBrush x:Key="Accent" Color="#D9A84E" />
      <SolidColorBrush x:Key="AccentSoft" Color="#3D3221" />
      <SolidColorBrush x:Key="Warn" Color="#F08A5D" />
      <SolidColorBrush x:Key="Track" Color="#3A3C41" />

      <v:VisibleWhenConverter x:Key="Vis" />
      <v:ActiveWhenEqualsConverter x:Key="Active" />
      <v:ShortCurrencyConverter x:Key="CurrencyName" />
      <v:PillActiveConverter x:Key="PillActive" />

      <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

      <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      </Style>

      <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
      </Style>

      <!-- Tag = "active" highlights it (nav tabs and pill toggles). -->
      <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="active">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource TextDim}" Background="{StaticResource Surface}" VerticalAlignment="Center">
                  <TextBlock x:Name="tick" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                  <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                  <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Text}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="0,14,0,6" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>

      <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="ListBoxItem">
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Padding="8,6" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,0,0,2">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Roll bar: fill toward the best end, a light tick marks the best end, numbers always printed. -->
      <DataTemplate DataType="{x:Type vm:RollBarViewModel}">
        <StackPanel Margin="0,3,0,0" Visibility="{Binding HasAnything, Converter={StaticResource Vis}}">
          <Grid Height="10" Visibility="{Binding HasBar, Converter={StaticResource Vis}}">
            <Grid Visibility="{Binding IsScored, Converter={StaticResource Vis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding FillWidth}" />
                <ColumnDefinition Width="{Binding RestWidth}" />
                <ColumnDefinition Width="2" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Accent}" Margin="0,2" />
              <Border Grid.Column="1" Background="{StaticResource Track}" Margin="0,2" />
              <Border Grid.Column="2" Background="{StaticResource Text}" />
            </Grid>
            <Grid Visibility="{Binding IsPositionOnly, Converter={StaticResource Vis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding MarkerBefore}" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="{Binding MarkerAfter}" />
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="3" Background="{StaticResource Track}" Margin="0,3" />
              <Border Grid.Column="1" Background="{StaticResource TextDim}" />
            </Grid>
          </Grid>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </StackPanel>
      </DataTemplate>

      <!-- Full modifier row (inspector). -->
      <DataTemplate x:Key="ModRowFull" DataType="{x:Type vm:ModRowViewModel}">
        <Border Padding="0,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TierLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="10,0,0,0" />
              <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="{StaticResource Warn}" Margin="0,0,6,0" Visibility="{Binding Uncertain, Converter={StaticResource Vis}}" ToolTip="Do not take this line at face value: see the note below." />
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding MetaLine}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
            <ItemsControl ItemsSource="{Binding Bars}" />
            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Candidates}" Margin="8,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- Compact modifier row (HUD card). -->
      <DataTemplate x:Key="ModRowPeek" DataType="{x:Type vm:ModRowViewModel}">
        <StackPanel Margin="0,0,0,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding TierLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="{StaticResource Warn}" Margin="0,0,5,0" Visibility="{Binding Uncertain, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Bars}" />
          <TextBlock Text="Ambiguous: advanced copy (Ctrl+Alt+C) splits it" FontSize="12" Foreground="{StaticResource Warn}" Visibility="{Binding IsAmbiguous, Converter={StaticResource Vis}}" />
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:InspectViewModel}">
        <v:InspectView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <v:PlaceholderView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
