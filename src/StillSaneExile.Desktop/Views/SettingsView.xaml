<UserControl x:Class="StillSaneExile.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             xmlns:pricing="clr-namespace:StillSaneExile.Domain.Pricing;assembly=StillSaneExile.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseDown="OnPreviewMouseDown"
             Focusable="True">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- One line under a setting that says what it does; the rest is under Details. -->
    <Style x:Key="Gist" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </UserControl.Resources>

  <Grid>
  <!-- First start shows onboarding instead; it is only created while onboarding is open. -->
  <ContentControl Focusable="False">
    <ContentControl.Style>
      <Style TargetType="ContentControl">
        <Setter Property="Content" Value="{x:Null}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsOnboarding}" Value="True">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <v:OnboardingView />
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ContentControl.Style>
  </ContentControl>

  <!-- Settings in short pages: a rail of sections on the left, one section at a time on the right. -->
  <Grid Margin="28,24,28,0" Visibility="{Binding IsOnboarding, Converter={StaticResource Vis}, ConverterParameter=invert}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="28" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel>
      <TextBlock Text="Settings" Style="{StaticResource Heading}" FontSize="28" FontWeight="ExtraBold" Margin="4,0,0,14" />
      <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.Sections}" AutomationProperties.Name="Settings sections">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SettingsSection}">
            <Button Style="{StaticResource TabButton}" Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2"
                    Command="{Binding DataContext.ShowSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}">
              <Button.Tag>
                <MultiBinding Converter="{StaticResource PillActive}">
                  <Binding Path="Key" />
                  <Binding Path="DataContext.Section" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </MultiBinding>
              </Button.Tag>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,40">
        <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,8" Margin="0,0,0,14" Visibility="{Binding Message, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- League and prices -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=general}">
          <TextBlock Text="League and prices" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Where you play" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Style="{StaticResource ChoiceButton}" Content="Practice with demo data" Command="{Binding UseDemoCommand}" Margin="0,0,8,0"
                        Tag="{Binding LiveSelected, Converter={StaticResource Active}, ConverterParameter=False}" />
                <TextBlock Text="or a live league:" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="4,0,8,0" />
                <TextBox Width="220" Text="{Binding LeagueDraft, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="Live league name" ToolTip="Pick a league below or type its name exactly as the game shows it" />
                <Button Content="Confirm league" Command="{Binding ConfirmLeagueCommand}" Margin="8,0,0,0" />
              </WrapPanel>
              <!-- poe.ninja's leagues: a pick fills the name box; "Confirm league" still decides. -->
              <WrapPanel Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding LeagueChoices}" Focusable="False" AutomationProperties.Name="Leagues on poe.ninja">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource ChoiceButton}" MinHeight="36" Padding="14,0" Margin="0,0,8,6" Content="{Binding}"
                              Command="{Binding DataContext.PickLeagueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Button.Tag>
                          <MultiBinding Converter="{StaticResource PillActive}">
                            <Binding />
                            <Binding Path="DataContext.LeagueDraft" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                          </MultiBinding>
                        </Button.Tag>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource LinkButton}" FontSize="14.5" Content="Get the league list from poe.ninja" Command="{Binding LoadLeaguesCommand}"
                        Visibility="{Binding CanLoadLeagues, Converter={StaticResource Vis}}" ToolTip="One request to poe.ninja for the leagues it has prices for" />
              </WrapPanel>
              <TextBlock Text="{Binding LeagueListStatus}" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Visibility="{Binding LeagueListStatus, Converter={StaticResource Vis}}" />
              <TextBlock FontSize="14.5" Margin="0,6,0,0" Visibility="{Binding ConfirmedLeague, Converter={StaticResource Vis}}">
                <Run Text="Confirmed live league: " Foreground="{StaticResource TextDim}" /><Run Text="{Binding ConfirmedLeague, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
              <TextBlock Style="{StaticResource Gist}" Text="Demo prices are made up for practice and never appear in a live league." />
              <Expander Style="{StaticResource Details}" Header="How leagues work">
                <TextBlock Style="{StaticResource FinePrint}"
                           Text="The demo profile uses made-up prices and listings so you can practice; they never appear in a live profile. Its practice items carry the game's 0.5.5 tiers and ranges, not checked in the game. A live league must be confirmed once and is remembered. Switching league swaps prices, comparables and holdings together, and never shows the previous league's prices, even while a refresh is running." />
              </Expander>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Show prices in" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{Binding CurrencyChoices}" AutomationProperties.Name="Show prices in">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Converter={StaticResource CurrencyName}}"
                            Command="{Binding DataContext.SetCurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <Button.Tag>
                        <MultiBinding Converter="{StaticResource PillActive}">
                          <Binding />
                          <Binding Path="DataContext.CurrentCurrency" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </Button.Tag>
                      <StackPanel Orientation="Horizontal">
                        <v:CurrencyIcon Currency="{Binding}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Converter={StaticResource CurrencyName}}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Gist}" Text="Most players price in Divine. Cheap items still show in Exalted." />
              <Expander Style="{StaticResource Details}" Header="How prices convert">
                <TextBlock Style="{StaticResource FinePrint}" Text="Prices convert with decimal math and round only for display; with no usable rate the original currency is shown." />
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Keys, and exactly what each one reads -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=keys}">
          <TextBlock Text="Keys" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Quick price" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyCap}" HorizontalAlignment="Left"><TextBlock Text="{Binding PeekKey}" FontWeight="SemiBold" /></Border>
                <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Content="Change" AutomationProperties.Name="Change the quick price key" Command="{Binding StartRecordingCommand}" CommandParameter="peek" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Change the search" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyCap}" HorizontalAlignment="Left"><TextBlock Text="{Binding OpenLastKey}" FontWeight="SemiBold" /></Border>
                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Content="Change" AutomationProperties.Name="Change the key that changes the search" Command="{Binding StartRecordingCommand}" CommandParameter="openLast" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Stash prices (hold)" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyCap}" HorizontalAlignment="Left"><TextBlock Text="{Binding StashKey}" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" /></Border>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                  <Button Content="Change" AutomationProperties.Name="Change the stash prices key" Command="{Binding StartRecordingCommand}" CommandParameter="stash" Margin="0,3" />
                  <TextBlock Text="{Binding StashKeyNote}" Foreground="{StaticResource TextFaint}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding ReadsExplanation}" Style="{StaticResource Gist}" Margin="0,12,0,0" />
              <ItemsControl ItemsSource="{Binding KeyWarnings}" Margin="0,6,0,0" AutomationProperties.Name="Key warnings">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Gist}"
                         Text="SSE only listens: it passes every key on to the game unchanged and never sends keys, clicks or chat." />
              <Expander Style="{StaticResource Details}" Header="What SSE listens to">
                <TextBlock Style="{StaticResource FinePrint}"
                           Text="The app observes physical key presses (and side mouse buttons, while one is bound or Settings is open) and passes every one on to the game unchanged. It ignores synthetic input, never sends keys, clicks or chat, and never reads game memory or files. It looks at where the mouse cursor is only when you press the quick price key, to put the ring there and place the card, and while you hold it, to notice you moving onto the card." />
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Key tester" Style="{StaticResource CardTitle}" />
              <TextBlock Style="{StaticResource CardLead}" Text="Press, hold and release any key or side mouse button while Settings is in front." />
              <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                <TextBlock Text="{Binding TestLog}" FontSize="16" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The quick price card -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=card}">
          <TextBlock Text="Price card" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Showing and hiding" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Hide when I let go, unless I move onto the card" Command="{Binding SetPeekModeCommand}" CommandParameter="hold" Margin="0,0,6,6"
                        Tag="{Binding ToggleMode, Converter={StaticResource Active}, ConverterParameter=False}" />
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Press again to hide (accessibility)" Command="{Binding SetPeekModeCommand}" CommandParameter="toggle" Margin="0,0,0,6"
                        Tag="{Binding ToggleMode, Converter={StaticResource Active}, ConverterParameter=True}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Gist}" Text="Move the mouse onto the card while you hold the key to keep it open and tick stats on it." />
              <Expander Style="{StaticResource Details}" Header="How the card behaves">
                <StackPanel>
                  <TextBlock Style="{StaticResource FinePrint}"
                             Text="Hold the key to see the price. Move the mouse onto the card to keep it open and tick stats on it; let go without moving and it hides. Press again to hide: one press shows the card, the next one hides it, so you never hold a key." />
                  <TextBlock Style="{StaticResource FinePrint}"
                             Text="A ring at the cursor answers each press straight away, before the item is read. The card then slides in from the cursor's side, with a short line to it when it is further away, and flashes once it has landed. With nothing under the cursor there is no card: a red ring and a short note say so. Pressing again over the item the card shows keeps that card and flashes it." />
                  <TextBlock Style="{StaticResource FinePrint}"
                             Text="While you hold the key the card is click-through and never takes focus. Once you move onto it, it takes clicks (never the focus: the game keeps your keyboard) and stays until you close it (×) or check another item. Any card hides when another program comes to the front, on minimize, lock and resolution change. Windowed or borderless only; exclusive fullscreen cannot show it." />
                </StackPanel>
              </Expander>
              <CheckBox IsChecked="{Binding LessMotion}" Content="Less motion: no ring, slide or line, the card only fades" Margin="0,14,0,0" />
              <TextBlock Text="{Binding MotionNote}" Style="{StaticResource Gist}" Visibility="{Binding MotionNote, Converter={StaticResource Vis}}" />
              <CheckBox IsChecked="{Binding PressClick}" Content="A soft click when the key is heard" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Place and size" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
              <WrapPanel>
                <TextBlock Text="Place the card" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource FieldLabel}" />
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Next to the game tooltip" Command="{Binding SetPositionCommand}" CommandParameter="tooltip" Margin="0,0,6,0"
                        Tag="{Binding Position, Converter={StaticResource Active}, ConverterParameter=Tooltip}" />
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Screen edge" Command="{Binding SetPositionCommand}" CommandParameter="edge" Margin="0,0,6,0"
                        Tag="{Binding Position, Converter={StaticResource Active}, ConverterParameter=Edge}" />
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Fixed spot (drag once)" Command="{Binding SetPositionCommand}" CommandParameter="fixed"
                        Tag="{Binding Position, Converter={StaticResource Active}, ConverterParameter=Fixed}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Gist}" Text="{Binding PositionNote}" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Scale" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                <Slider Width="240" Minimum="0.5" Maximum="1.6" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" Value="{Binding PeekScale}"
                        AutomationProperties.Name="Quick price card scale" />
                <TextBlock Text="{Binding PeekScale, StringFormat='{}{0:0.00}×'}" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>
              <TextBlock Style="{StaticResource Gist}" Text="Scale is the card's own size. Windows' text size enlarges this window and the price check over the game, not the card." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Price colours: where each colour of the price label starts. The rows are a draft that the
             preview follows as you type; Apply saves it and recolours every open card and price check. -->
        <StackPanel x:Name="PriceColoursCard" DataContext="{Binding Colours}"
                    Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}, ConverterParameter=colours}">
          <TextBlock Text="Price colours" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" MinWidth="300" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Where each colour starts" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Gist}" Margin="0,4,0,14" MaxWidth="430" HorizontalAlignment="Left"
                           Text="The louder the label, the more an item is worth. Early in a league, 1 div can already be a jackpot." />
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Grid.IsSharedSizeScope="True" AutomationProperties.Name="Where each colour starts">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ColourStepViewModel}">
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="Swatch" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:ValueLabel Text="{Binding Name}" Tier="{Binding Tier}" Size="Medium" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="from" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                        <TextBox Grid.Column="2" Width="76" Height="34" MinHeight="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding AmountName}">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWrong}" Value="True">
                                  <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                          <Button Style="{StaticResource SegmentButton}" MinHeight="34" Padding="8,0" Margin="0,0,2,0" ToolTip="Divine Orbs"
                                  Command="{Binding SetCurrencyCommand}" CommandParameter="divine" AutomationProperties.Name="{Binding DivineName}"
                                  Tag="{Binding Currency, Converter={StaticResource Active}, ConverterParameter=divine}">
                            <StackPanel Orientation="Horizontal">
                              <v:CurrencyIcon Currency="divine" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center" />
                              <TextBlock Text="div" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Style="{StaticResource SegmentButton}" MinHeight="34" Padding="8,0" ToolTip="Exalted Orbs"
                                  Command="{Binding SetCurrencyCommand}" CommandParameter="exalted" AutomationProperties.Name="{Binding ExaltedName}"
                                  Tag="{Binding Currency, Converter={StaticResource Active}, ConverterParameter=exalted}">
                            <StackPanel Orientation="Horizontal">
                              <v:CurrencyIcon Currency="exalted" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center" />
                              <TextBlock Text="ex" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- The dark tag has no start of its own: everything under tan. -->
                <StackPanel Orientation="Horizontal">
                  <v:ValueLabel Text="Dark" Tier="{x:Static pricing:ValueTier.E}" Size="Medium" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DarkFrom}" Style="{StaticResource FieldLabel}" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Problem}" FontSize="14.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Visibility="{Binding HasProblem, Converter={StaticResource Vis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Apply" MinWidth="110" Command="{Binding ApplyCommand}"
                          AutomationProperties.HelpText="Saves the colours: every card and price check uses them from now on" />
                  <Button Content="Undo changes" Command="{Binding UndoCommand}" Margin="8,0,0,0" />
                  <Button Style="{StaticResource LinkButton}" Content="Default steps" Command="{Binding UseDefaultCommand}" FontSize="14.5" Margin="14,0,0,0" VerticalAlignment="Center"
                          ToolTip="10 div, 1 div, 30 ex, 6 ex and 1 ex. Apply still decides." />
                </StackPanel>
              </StackPanel>

              <!-- Made-up items at made-up prices, in the colours as typed: what Apply would do to them. -->
              <StackPanel Grid.Column="2">
                <TextBlock Text="Preview" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Gist}" Margin="0,4,0,14" Text="Follows as you type. Cards change when you press Apply." />
                <Border Style="{StaticResource GamePanel}">
                  <Border Style="{StaticResource GamePanelInner}" Padding="14,8">
                    <ItemsControl ItemsSource="{Binding Examples}" Focusable="False" AutomationProperties.Name="Preview">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColourExampleViewModel}">
                          <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
                              <TextBlock Text="{Binding Base}" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <v:ValueLabel Grid.Column="1" Text="{Binding Price}" Tier="{Binding Tier}" Size="Medium" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Border>
                <TextBlock Text="Made-up items and prices." FontSize="13.5" Foreground="{StaticResource TextFaint}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding RateLine}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Crafting: how the simulator uses an orb. -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=crafting}">
          <TextBlock Text="Crafting" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Using an orb" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Pick it up, then click the item (like in game)" Command="{Binding SetCraftUseCommand}" CommandParameter="pickup" Margin="0,0,6,6"
                        Tag="{Binding CraftPickUp, Converter={StaticResource Active}, ConverterParameter=True}" />
                <Button Style="{StaticResource ChoiceButton}" MinHeight="40" Content="Click the orb to use it" Command="{Binding SetCraftUseCommand}" CommandParameter="click" Margin="0,0,0,6"
                        Tag="{Binding CraftPickUp, Converter={StaticResource Active}, ConverterParameter=False}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Gist}" Text="Like in game: click an orb and it follows the cursor, then click the item. Hold Shift to keep it for the next click; right-click or Esc puts it back." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Live prices and the trade site: what is fetched, when, and the switches -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=market}">
          <TextBlock Text="Live prices and trade" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox IsChecked="{Binding LivePricesOn}" Content="Live prices from poe.ninja for your live league, refreshed every hour" />
              <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Gist}" />
              <TextBlock Text="{Binding LiveHold}" TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource Warn}" Margin="0,4,0,0"
                         Visibility="{Binding LiveHold, Converter={StaticResource Vis}}" />
              <TextBlock Text="{Binding LiveProblem}" TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource Warn}" Margin="0,4,0,0"
                         Visibility="{Binding LiveProblem, Converter={StaticResource Vis}}" />
              <Expander Style="{StaticResource Details}" Header="What SSE asks poe.ninja">
                <StackPanel>
                  <TextBlock Style="{StaticResource FinePrint}"
                             Text="With a live league confirmed, SSE asks poe.ninja a few seconds after it starts, then every hour, for that league's exchange prices (currency, fragments, essences, runes, soul cores, idols, uncut gems, lineage supports, omens, delirium, expedition, verisium, abyss bones, breach catalysts and splinters) and unique item prices: about 23 requests, one at a time, at least 5 seconds apart, following poe.ninja's cache headers. Each request names the league, the category and SSE's version, nothing about you, your account or your items. The last few refreshes stay in the data folder, so prices still show when you're offline, with their age." />
                  <TextBlock Style="{StaticResource FinePrint}"
                             Text="The prices are poe.ninja's own estimates for the whole league. Unique prices are a baseline for the item, not for your rolls. Prices are marked stale after two missed hourly refreshes, and too old to rank after 24 hours. A key press never asks poe.ninja for anything: the card over the game only reads what is already here. Rares have no price list: Search finds their listings on the trade site." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox IsChecked="{Binding TradeSearchOn}" Content="Search the trade site from SSE" />
              <TextBlock Style="{StaticResource Gist}" Text="Only when you click Search on a live item: never on a key press, never in the demo. Off, Search tells you to open the search on the trade site instead." />
              <Expander Style="{StaticResource Details}" Header="What Search sends to the trade site">
                <TextBlock Style="{StaticResource FinePrint}"
                           Text="When you click Search on the price card or the price check of a live item, SSE asks the official Path of Exile trade site for the listings that match: one search, then one request for the ten cheapest. The requests carry the search (the item's base, rarity, the stats and numbers you ticked, your live league) and SSE's version; no login, no cookies, nothing about your account. SSE keeps within the limits the site announces and waits when it asks. Prices come from instant buyout listings; the sellers' names are never read or shown." />
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Prices you write down" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="They expire after" VerticalAlignment="Center" />
                <TextBox Width="48" Margin="8,0" Text="{Binding ExpiryDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Days until prices you write down expire" />
                <TextBlock Text="days" VerticalAlignment="Center" />
              </StackPanel>
              <Button Content="Remove demo prices and holdings I added" Command="{Binding ResetDemoDataCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Stash pictures for #3: what is taken, where it goes, the switch, and the pictures to label. Off by default. -->
        <StackPanel x:Name="StashPicturesCard" DataContext="{Binding Pictures}"
                    Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}, ConverterParameter=pictures}">
          <TextBlock Text="Stash pictures" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Stash reading (coming soon): help build it" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
              <TextBlock Text="{Binding Lead}" Style="{StaticResource Gist}" Margin="0" />
              <CheckBox IsChecked="{Binding IsCollecting}" Content="{Binding SwitchLabel}" Margin="0,12,0,0" />
              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource Warn}" Margin="0,8,0,0"
                         Visibility="{Binding Problem, Converter={StaticResource Vis}}" />
              <TextBlock Text="{Binding PrivacyText}" TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource Hint}" Margin="0,10,0,0" />
              <Expander Style="{StaticResource Details}" Header="What a picture holds, and where it goes">
                <StackPanel>
                  <TextBlock Text="{Binding WhatIsTaken}" Style="{StaticResource FinePrint}" />
                  <TextBlock Text="{Binding WhereSaved}" Style="{StaticResource FinePrint}" />
                </StackPanel>
              </Expander>
              <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="{Binding Summary}" FontSize="14.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Open the pictures folder" Command="{Binding OpenFolderCommand}" ToolTip="Opens the folder in Explorer" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- The pictures collected so far, and the labels the player adds. -->
          <Border Style="{StaticResource Card}" Visibility="{Binding HasPictures, Converter={StaticResource Vis}}">
            <StackPanel>
              <TextBlock Text="Label your pictures" Style="{StaticResource CardTitle}" />
              <TextBlock Style="{StaticResource CardLead}" Text="{Binding ReviewLead}" />
              <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14.5" />
              </Border>
              <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,12,0,0" AutomationProperties.Name="Stash pictures you collected">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:StashPictureViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,14">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="240" />
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Height="137" VerticalAlignment="Top">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="1" />
                        </Border>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Facts}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                          <ItemsControl ItemsSource="{Binding TabChoices}" Focusable="False" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:TabChoiceViewModel}">
                                <Button Style="{StaticResource ChoiceButton}" MinHeight="32" Padding="12,0" FontSize="14.5" Margin="0,0,6,6"
                                        Content="{Binding Label}" Command="{Binding ChooseCommand}" AutomationProperties.Name="{Binding SpokenName}"
                                        Tag="{Binding IsChosen, Converter={StaticResource Active}, ConverterParameter=True}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <WrapPanel Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Visibility="{Binding IsCurrency, Converter={StaticResource Vis}}">
                              <TextBlock Text="Subtab" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                              <TextBox Width="170" Text="{Binding Subtab, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding SubtabName}"
                                       ToolTip="The currency tab's subtab, as the game names it" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                              <TextBlock Text="In-game UI scale" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                              <TextBox Width="80" Text="{Binding UiScale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding UiScaleName}"
                                       ToolTip="The game's own UI scale setting, as the game shows it" />
                            </StackPanel>
                          </WrapPanel>
                          <TextBlock Text="{Binding UiScaleProblem}" FontSize="13.5" Foreground="{StaticResource Warn}" Margin="0,0,0,6"
                                     Visibility="{Binding UiScaleProblem, Converter={StaticResource Vis}}" />
                          <DockPanel>
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding NoteName}"
                                     ToolTip="Optional: a tooltip over a stack, a row cut off, the game's patch or language..." />
                          </DockPanel>
                          <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding HeldOut}" Content="Held out: keep it apart from tuning" AutomationProperties.Name="{Binding HeldOutName}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Delete" AutomationProperties.Name="{Binding DeleteName}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    ToolTip="Deletes the picture and its notes from this computer" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Version, updates, data and privacy -->
        <StackPanel Visibility="{Binding Section, Converter={StaticResource VisibleWhen}, ConverterParameter=about}">
          <TextBlock Text="Updates and privacy" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Closing and minimizing" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
              <CheckBox IsChecked="{Binding CloseToTray}" Content="Closing the window keeps SSE running in the notification area" />
              <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimizing hides the window there too, without a taskbar button" Margin="0,10,0,0" />
              <TextBlock Style="{StaticResource Gist}" Text="Its keys keep working. To quit, right-click its icon by the clock and choose Quit." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel>
                <TextBlock VerticalAlignment="Center">
                  <Run Text="Still Sane, Exile? " Foreground="{StaticResource TextDim}" /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Style="{StaticResource LinkButton}" FontSize="14.5" Margin="14,0,0,0" VerticalAlignment="Center"
                        Content="{Binding WhatsNew.LinkLabel}" Command="{Binding WhatsNew.ShowCurrentCommand}"
                        ToolTip="Shows this version's notes at the top of the window" />
              </WrapPanel>
              <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Gist}" Margin="0,4,0,0" />
              <CheckBox IsChecked="{Binding AutoUpdate}" Margin="0,10,0,0" IsEnabled="{Binding Updates.IsInstalled}"
                        Content="Check for updates automatically (at start and every 6 hours)" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding Updates.IsInstalled}" Margin="0,0,8,0" />
                <Button Content="Restart now to update" Command="{Binding RestartToUpdateCommand}"
                        Visibility="{Binding Updates.IsReady, Converter={StaticResource Vis}}" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Gist}" Text="Updates come from the project's GitHub releases. A downloaded one installs when you quit SSE, or when SSE next starts if Windows shut down first; never in the middle of a game unless you ask." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Data and privacy" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
              <TextBlock TextWrapping="Wrap" FontSize="14.5" Foreground="{StaticResource TextDim}">
                <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" Foreground="{StaticResource Text}" />
              </TextBlock>
              <TextBlock Style="{StaticResource Gist}" Text="Nothing about you leaves this computer. SSE makes three kinds of request, each with its own switch: updates, live prices and trade site search." />
              <Expander Style="{StaticResource Details}" Header="Everything SSE keeps and sends">
                <TextBlock Style="{StaticResource FinePrint}"
                           Text="Clipboard text is kept in memory only while it is a parsed item, and saved to disk only with a comparison set you create. Anything that is not an item is discarded at once. SSE makes three kinds of network request: the update check to GitHub; for a live league with live prices on, that league's prices from poe.ninja every hour (plus poe.ninja's league list when you pick a league); and, only when you click Search on a live item, that search on the official trade site. None of them sends anything about you, and each has its switch on these pages. &quot;Open this search on the trade site&quot; opens it in your browser. The pictures of Divine, Exalted and Chaos Orbs and the fonts ship with the app." />
              </Expander>
              <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"
                         Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Grid>
</UserControl>
