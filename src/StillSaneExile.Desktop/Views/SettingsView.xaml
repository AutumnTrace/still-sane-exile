<UserControl x:Class="StillSaneExile.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">

      <StackPanel Visibility="{Binding IsOnboarding, Converter={StaticResource Vis}}">
        <TextBlock Text="Welcome, exile" FontSize="24" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" FontSize="15"
                   Text="Three things to set: which profile and league, which currency to show prices in, and which keys do what. No account is needed and nothing you do here leaves this computer." />
      </StackPanel>
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Visibility="{Binding IsOnboarding, Converter={StaticResource Vis}, ConverterParameter=invert}" />

      <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,12,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <!-- 1. Profile and league -->
      <TextBlock Text="1 · PROFILE AND LEAGUE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource TabButton}" Content="Demo (synthetic data)" Command="{Binding UseDemoCommand}" Margin="0,0,8,0"
                    Tag="{Binding LiveSelected, Converter={StaticResource Active}, ConverterParameter=False}" />
            <TextBlock Text="or a live league:" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="4,0,8,0" />
            <TextBox Width="220" Text="{Binding LeagueDraft, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Type the league name exactly as the game shows it" />
            <Button Content="Confirm league" Command="{Binding ConfirmLeagueCommand}" Margin="8,0,0,0" />
          </WrapPanel>
          <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0">
            <Run Text="The demo profile uses synthetic prices, ranges and listings so you can practice; they never appear in a live profile. A live league must be confirmed once and is remembered. Switching league swaps prices and comparables together. Live market data (poe.ninja and GGG's exchange history, through a shared cache) arrives in Milestone 2; until then a live profile has no prices and says so." />
          </TextBlock>
          <TextBlock FontSize="12" Margin="0,6,0,0" Visibility="{Binding ConfirmedLeague, Converter={StaticResource Vis}}">
            <Run Text="Confirmed live league: " Foreground="{StaticResource TextDim}" /><Run Text="{Binding ConfirmedLeague, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- 2. Currency -->
      <TextBlock Text="2 · DISPLAY CURRENCY" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding CurrencyChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource TabButton}" Margin="0,0,8,0" Content="{Binding Converter={StaticResource CurrencyName}}"
                        Command="{Binding DataContext.SetCurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <Button.Tag>
                    <MultiBinding Converter="{StaticResource PillActive}">
                      <Binding />
                      <Binding Path="DataContext.CurrentCurrency" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                  </Button.Tag>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Prices convert with decimal math and round only for display. With no usable rate the original currency is shown instead." />
        </StackPanel>
      </Border>

      <!-- 3. Keys -->
      <TextBlock Text="3 · KEYS, AND EXACTLY WHAT EACH ONE READS" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Item peek (hold)" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeekKey}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Content="Change" Command="{Binding StartRecordingCommand}" CommandParameter="peek" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="Open last item" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpenLastKey}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Content="Change" Command="{Binding StartRecordingCommand}" CommandParameter="openLast" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="Stash / Aldur labels" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StashKey}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
              <Button Content="Change" Command="{Binding StartRecordingCommand}" CommandParameter="stash" Margin="0,3" />
              <TextBlock Text="not active yet (Milestone 2)" Foreground="{StaticResource Warn}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ReadsExplanation}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,10,0,0" />
          <ItemsControl ItemsSource="{Binding KeyWarnings}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="KEY TESTER: press, hold and release any key while this page is in front" FontSize="11" Foreground="{StaticResource TextFaint}" />
              <TextBlock Text="{Binding TestLog}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="The app observes physical key presses and passes every key on to the game unchanged. It ignores synthetic input, never sends keys, clicks or chat, and never reads game memory or files." />
        </StackPanel>
      </Border>

      <!-- HUD -->
      <TextBlock Text="HUD CARD" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox IsChecked="{Binding ToggleMode}" Content="Toggle instead of hold (accessibility): first press shows a frozen snapshot, next press dismisses it" />
          <WrapPanel Margin="0,10,0,0">
            <TextBlock Text="Place the card" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Style="{StaticResource TabButton}" Content="Opposite the cursor" Command="{Binding SetAnchorCommand}" CommandParameter="Auto" Margin="0,0,6,0"
                    Tag="{Binding Anchor, Converter={StaticResource Active}, ConverterParameter=Auto}" />
            <Button Style="{StaticResource TabButton}" Content="Always left" Command="{Binding SetAnchorCommand}" CommandParameter="Left" Margin="0,0,6,0"
                    Tag="{Binding Anchor, Converter={StaticResource Active}, ConverterParameter=Left}" />
            <Button Style="{StaticResource TabButton}" Content="Always right" Command="{Binding SetAnchorCommand}" CommandParameter="Right"
                    Tag="{Binding Anchor, Converter={StaticResource Active}, ConverterParameter=Right}" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider Width="220" Minimum="0.75" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding PeekScale}" />
            <TextBlock Text="{Binding PeekScale, StringFormat='{}{0:0.00}×'}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="The card keeps clear of the screen centre, the skill bar and the top-right map. It is click-through, never takes focus, and hides on release, focus loss, minimize, lock and resolution change. Windowed or borderless only; exclusive fullscreen cannot show it." />
        </StackPanel>
      </Border>

      <!-- Comparables -->
      <TextBlock Text="COMPARABLES" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Prices you enter expire after" VerticalAlignment="Center" />
            <TextBox Width="44" Margin="8,0" Text="{Binding ExpiryDays, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="days" VerticalAlignment="Center" />
          </StackPanel>
          <Button Content="Remove demo comparables I added" Command="{Binding ResetDemoDataCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <!-- Version and updates -->
      <TextBlock Text="VERSION AND UPDATES" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock>
            <Run Text="Still Sane, Exile? " Foreground="{StaticResource TextDim}" /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,4,0,0" />
          <CheckBox IsChecked="{Binding AutoUpdate}" Margin="0,10,0,0" IsEnabled="{Binding Updates.IsInstalled}"
                    Content="Check for updates automatically (at start and every 6 hours)" />
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding Updates.IsInstalled}" Margin="0,0,8,0" />
            <Button Style="{StaticResource AccentButton}" Content="Restart now to update" Command="{Binding RestartToUpdateCommand}"
                    Visibility="{Binding Updates.IsReady, Converter={StaticResource Vis}}" />
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,8,0,0"
                     Text="Updates come from the project's GitHub releases. A downloaded update installs when you close SSE, so it never restarts in the middle of a game unless you ask." />
        </StackPanel>
      </Border>

      <!-- About and data -->
      <TextBlock Text="DATA AND PRIVACY" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}">
            <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" Foreground="{StaticResource Text}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,6,0,0"
                     Text="Clipboard text is kept in memory only while it is a parsed item, and saved to disk only with a comparison set you create. Anything that is not an item is discarded at once. The only network request SSE makes is the update check to GitHub (switch it off above); the trade site opens in your browser when you ask." />
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0"
                     Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." />
        </StackPanel>
      </Border>

      <Button Style="{StaticResource AccentButton}" Content="Done, take me to Inspect" Command="{Binding FinishOnboardingCommand}" HorizontalAlignment="Left" Margin="0,8,0,24"
              Visibility="{Binding IsOnboarding, Converter={StaticResource Vis}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
