<UserControl x:Class="StillSaneExile.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="22,20" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="1280" Margin="28,40,28,48">
      <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="FIRST START · ABOUT A MINUTE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Link}" />
        <TextBlock Text="Welcome, exile." FontSize="36" FontWeight="ExtraBold" Margin="0,8,0,0" />
        <TextBlock Text="Three quick choices, then how to read a price check. No account needed." FontSize="16" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>

      <Grid Margin="0,28,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="480" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <!-- 1 · Profile -->
          <Border Style="{StaticResource StepCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepDot}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Where are you playing?" Style="{StaticResource StepTitle}" />
              </StackPanel>
              <UniformGrid Columns="2" Margin="0,14,0,0">
                <Button Style="{StaticResource ChoiceButton}" v:Ui.Radius="10" MinHeight="64" Padding="14,10" HorizontalContentAlignment="Left" Margin="0,0,5,0"
                        Command="{Binding UseDemoCommand}" Tag="{Binding ProfileChoice, Converter={StaticResource Active}, ConverterParameter=demo}"
                        AutomationProperties.Name="Practice with demo data" AutomationProperties.HelpText="Made-up items and prices to learn with">
                  <StackPanel>
                    <TextBlock Text="Practice with demo data" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Made-up items and prices to learn with" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ChoiceButton}" v:Ui.Radius="10" MinHeight="64" Padding="14,10" HorizontalContentAlignment="Left" Margin="5,0,0,0"
                        Command="{Binding ChooseLiveCommand}" Tag="{Binding ProfileChoice, Converter={StaticResource Active}, ConverterParameter=live}"
                        AutomationProperties.Name="A live league" AutomationProperties.HelpText="Real prices come in a later update">
                  <StackPanel>
                    <TextBlock Text="A live league" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Real prices come in a later update" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                  </StackPanel>
                </Button>
              </UniformGrid>
              <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowLeagueInput, Converter={StaticResource Vis}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding LeagueDraft, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" AutomationProperties.Name="League name" ToolTip="Type the league name exactly as the game shows it" />
                  <Button Grid.Column="1" Content="Confirm league" Command="{Binding ConfirmLeagueCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Text="Type the league name exactly as the game shows it. Until live prices arrive, a live league shows no prices and says so." />
              </StackPanel>
              <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="{Binding ConfirmedLeague, Converter={StaticResource Vis}}">
                <Run Text="Live league: " /><Run Text="{Binding ConfirmedLeague, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- 2 · Currency -->
          <Border Style="{StaticResource StepCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepDot}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Show prices in" Style="{StaticResource StepTitle}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding CurrencyChoices}" Margin="0,14,0,0" Focusable="False" AutomationProperties.Name="Display currency">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Content="{Binding Converter={StaticResource CurrencyName}}"
                            Command="{Binding DataContext.SetCurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <Button.Tag>
                        <MultiBinding Converter="{StaticResource PillActive}">
                          <Binding />
                          <Binding Path="DataContext.CurrentCurrency" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </Button.Tag>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Small}" Margin="0,14,0,0" Text="Most players price in Divine. Cheap items still show in Exalted." />
            </StackPanel>
          </Border>

          <!-- 3 · Keys -->
          <Border Style="{StaticResource StepCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource StepDot}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Your keys" Style="{StaticResource StepTitle}" />
              </StackPanel>
              <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" FontWeight="Normal" Foreground="{StaticResource TextSoft}" v:Ui.Radius="6" AutomationProperties.Name="Change the quick price key" Command="{Binding StartRecordingCommand}" CommandParameter="peek" Margin="14,0,0,0" />
                  <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="14,0,0,0"><TextBlock Text="{Binding PeekKey}" FontSize="13" FontWeight="SemiBold" /></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quick price" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PeekHowTo}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" FontWeight="Normal" Foreground="{StaticResource TextSoft}" v:Ui.Radius="6" AutomationProperties.Name="Change the key that changes the search" Command="{Binding StartRecordingCommand}" CommandParameter="openLast" Margin="14,0,0,0" />
                  <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="14,0,0,0"><TextBlock Text="{Binding OpenLastKey}" FontSize="13" FontWeight="SemiBold" /></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Change the search" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock Text="Pick which stats to search and type your own numbers" Style="{StaticResource Small}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" FontWeight="Normal" Foreground="{StaticResource TextSoft}" v:Ui.Radius="6" AutomationProperties.Name="Change the stash prices key" Command="{Binding StartRecordingCommand}" CommandParameter="stash" Margin="14,0,0,0" />
                  <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" Margin="14,0,0,0"><TextBlock Text="{Binding StashKey}" FontSize="13" FontWeight="SemiBold" /></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Stash prices (hold) · coming later" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                    <TextBlock Text="Shows what items in your open stash are worth" Style="{StaticResource Small}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,4" Visibility="{Binding Message, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" />
              </Border>
              <ItemsControl ItemsSource="{Binding KeyWarnings}" Focusable="False" AutomationProperties.Name="Key warnings">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,2,0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Text="The app only listens to your keys. It never presses anything in the game." />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Content="Done — try a price check" Command="{Binding FinishOnboardingCommand}" MinHeight="48" Padding="24,0" FontSize="15" v:Ui.Radius="10" />
            <Button Style="{StaticResource LinkButton}" Command="{Binding SkipOnboardingCommand}" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Skip for now" TextDecorations="Underline" />
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- How to read a price check -->
        <Border Grid.Column="2" Background="#131417" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24,22" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="How to read a price check" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="Top to bottom: the item, the price, and what was searched." FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <v:PeekCard DataContext="{Binding SamplePeek}" HorizontalAlignment="Left" Margin="4,20,0,0" />
            <ItemsControl ItemsSource="{Binding GuideSteps}" Margin="0,22,0,0" Focusable="False" AutomationProperties.Name="How to read a price check">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GuideStep}">
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GuidePin}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
