<UserControl x:Class="StillSaneExile.Desktop.Views.PeekCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PeekViewModel}"
             x:Name="Self"
             Foreground="{StaticResource Text}">
  <UserControl.Resources>
    <Style x:Key="StatText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource TextOff}" />
    </Style>

    <Style x:Key="CardStep" TargetType="Button" BasedOn="{StaticResource StepButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="v:Ui.Radius" Value="5" />
    </Style>

    <!-- A row as the price searched with it, and on a pinned card the unique's name, which can't be unticked. -->
    <DataTemplate DataType="{x:Type vm:PeekRowViewModel}">
      <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border CornerRadius="3.5" Background="{StaticResource Accent}" Visibility="{Binding On, Converter={StaticResource Vis}}" AutomationProperties.Name="In search">
              <Path Data="M 4,8.2 L 6.6,10.8 L 12,5.4" Stroke="{StaticResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <Border CornerRadius="3.5" BorderBrush="{StaticResource Unchecked}" BorderThickness="1.5" Margin="0.5" Visibility="{Binding Off, Converter={StaticResource Vis}}" AutomationProperties.Name="Not in search" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Text}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding On}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Text}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasHint, Converter={StaticResource Vis}}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Right}" FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding On}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A stat on a pinned card: the item's own search row. Ticking it, or stepping its number, changes
         the search, and the price above follows. -->
    <DataTemplate DataType="{x:Type vm:SearchRowViewModel}">
      <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,3">
        <Grid MinHeight="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsOn}" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text}">
            <StackPanel Margin="-2,0,8,0">
              <TextBlock Text="{Binding Text}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource StatText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding IsAmbiguous, Converter={StaticResource Vis}}" />
            </StackPanel>
          </CheckBox>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource Vis}}">
            <Button Style="{StaticResource CardStep}" Content="−" Command="{Binding DecreaseCommand}" ToolTip="Lower" AutomationProperties.Name="{Binding LowerName}" />
            <TextBlock Text="{Binding BoundLabel}" MinWidth="46" TextAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="2,0" />
            <Button Style="{StaticResource CardStep}" Content="+" Command="{Binding IncreaseCommand}" ToolTip="Raise" AutomationProperties.Name="{Binding RaiseName}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding TierOrBlank}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Visibility="{Binding IsOn, Converter={StaticResource Vis}, ConverterParameter=invert}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The quick peek card: item, price, and exactly which stats the price searched with. Pinned, it
       has a close button, and its stats can be ticked. -->
  <Grid x:Name="Root">
    <Border x:Name="Card" Width="360" Background="#F715161A" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <Grid Margin="14,12,10,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="NameText" Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource DemoBadge}" Padding="6,2" VerticalAlignment="Top" Margin="10,2,4,0" Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
            <TextBlock Text="DEMO" FontSize="10" FontWeight="Bold" />
          </Border>
          <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="4,-4,0,0" VerticalAlignment="Top"
                  ToolTip="Close (Esc)" AutomationProperties.Name="Close the price card"
                  Command="{Binding CloseCommand, ElementName=Self}" Visibility="{Binding IsPinned, Converter={StaticResource Vis}}">
            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </Grid>

        <TextBlock Text="{Binding MessageText}" FontSize="14" TextWrapping="Wrap" Margin="14,0,14,12" Visibility="{Binding IsMessage, Converter={StaticResource Vis}}" />

        <Border x:Name="PriceBlock" Background="{StaticResource Surface3}" Padding="14,10" Visibility="{Binding HasAnswer, Converter={StaticResource Vis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Answer.Lead}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
              <TextBlock x:Name="BigText" Text="{Binding Answer.Big}" FontSize="24" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,2,0,2" />
              <TextBlock Text="{Binding Answer.PeekNote}" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Answer.NoteIsWarning}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <StackPanel x:Name="CountBlock" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding Answer.HasCount, Converter={StaticResource Vis}}">
              <TextBlock x:Name="CountText" Text="{Binding Answer.Count}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
              <TextBlock Text="for sale" FontSize="11.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
          <StackPanel x:Name="SearchedWith" Orientation="Horizontal" Margin="14,10,14,4">
            <TextBlock Text="SEARCHED WITH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
            <Border Style="{StaticResource AccentPill}" Padding="8,1" CornerRadius="9" Margin="8,0,0,0">
              <TextBlock FontSize="11.5"><Run Text="{Binding OnCount, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Total, Mode=OneWay}" /></TextBlock>
            </Border>
          </StackPanel>
          <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="14,0" Focusable="False" Visibility="{Binding ShowsStaticRows, Converter={StaticResource Vis}}" />
          <ItemsControl x:Name="LiveRowsList" ItemsSource="{Binding LiveRows}" Margin="14,0" Focusable="False" AutomationProperties.Name="Stats in the search"
                        Visibility="{Binding ShowsLiveRows, Converter={StaticResource Vis}}" />
        </StackPanel>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8,14,10" Margin="0,6,0,0">
          <DockPanel>
            <TextBlock x:Name="ChangeHint" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding ShowsChangeKey, Converter={StaticResource Vis}}">
              <Run Text="{Binding ChangeKey, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" /><Run Text=" change the search" />
            </TextBlock>
            <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12" FontWeight="SemiBold" Padding="4,2" Margin="10,-2,-4,-2" VerticalAlignment="Center"
                    Command="{Binding MoreCommand, ElementName=Self}" Visibility="{Binding ShowsMore, Converter={StaticResource Vis}}"
                    AutomationProperties.Name="All filters" AutomationProperties.HelpText="Opens the full price check for this item">
              <Button.ToolTip>
                <TextBlock><Run Text="Every filter and your own numbers (" /><Run Text="{Binding ChangeKey, Mode=OneWay}" /><Run Text=")" /></TextBlock>
              </Button.ToolTip>
              <TextBlock><Run Text="All filters" /><Run Text=" · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding ChangeKey, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
            </Button>
            <TextBlock x:Name="FooterText" Text="{Binding FooterHint}" FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Guide pins over the card (onboarding only), placed in code-behind next to what they explain. -->
    <Canvas x:Name="Pins" IsHitTestVisible="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
