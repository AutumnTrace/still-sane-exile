<UserControl x:Class="StillSaneExile.Desktop.Views.PeekCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PeekViewModel}"
             x:Name="Self"
             Foreground="{StaticResource Text}">
  <UserControl.Resources>
    <!-- A stat in the game's blue: bright and bold when searched, dimmer when not. A worked-out number
         (physical DPS) or a unique's name is a property: white when searched, grey when not. -->
    <Style x:Key="StatText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource StatOff}" />
    </Style>

    <Style x:Key="CardStep" TargetType="Button" BasedOn="{StaticResource StepButton}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- Small caps over a part of the card ("Searched with", "Cheapest 10 of 29"). -->
    <Style x:Key="CardHead" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The price and the listings of a search the player has changed since: still readable, clearly older. -->
    <Style x:Key="Dimmable" TargetType="FrameworkElement">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Item.IsDimmed}" Value="True">
          <Setter Property="Opacity" Value="0.65" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A row as the price searched with it, and on a pinned card the unique's name, which can't be unticked.
         Under a stat, its tier and roll bar; on the right, the number searched for, or where an unticked
         stat comes from (a rune, an implicit). -->
    <DataTemplate DataType="{x:Type vm:PeekRowViewModel}">
      <Border Padding="6,3">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding On}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Background="{StaticResource Accent}" Visibility="{Binding On, Converter={StaticResource Vis}}" AutomationProperties.Name="In search">
              <Path Data="M 3.3,7.6 L 6,10.3 L 11.6,4.6" Stroke="{StaticResource OnAccent}" StrokeThickness="2" />
            </Border>
            <Border BorderBrush="{StaticResource Unchecked}" BorderThickness="1.5" Margin="0.5" Visibility="{Binding Off, Converter={StaticResource Vis}}" AutomationProperties.Name="Not in search" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Text}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding On}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource StatOn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsProperty}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsProperty}" Value="True" />
                        <Condition Binding="{Binding On}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Hint}" FontSize="12.5" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasHint, Converter={StaticResource Vis}}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Right}" FontFamily="{StaticResource CapsFont}" FontSize="13.5" FontWeight="ExtraBold" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding On}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Under the whole row, so every bar of the card is as long whatever sits on the right. -->
          <v:RollLine Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" DataContext="{Binding Roll}" Margin="8,3,0,1" Visibility="{Binding Converter={StaticResource Vis}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A stat on a pinned card: the item's own search row. Ticking it, or stepping its number, changes
         the search; Search then updates the price and the listings above. -->
    <DataTemplate DataType="{x:Type vm:SearchRowViewModel}">
      <Border Padding="6,2">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid MinHeight="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <CheckBox IsChecked="{Binding IsOn}" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text}">
            <StackPanel Margin="-2,0,6,0">
              <TextBlock Text="{Binding Text}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource StatText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource StatOn}" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsProperty}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsProperty}" Value="True" />
                          <Condition Binding="{Binding IsOn}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Hint}" FontSize="12.5" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding IsAmbiguous, Converter={StaticResource Vis}}" />
            </StackPanel>
          </CheckBox>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource Vis}}">
            <Button Style="{StaticResource CardStep}" Content="−" Command="{Binding DecreaseCommand}" ToolTip="Lower" AutomationProperties.Name="{Binding LowerName}" />
            <TextBlock Text="{Binding BoundLabel}" MinWidth="38" TextAlignment="Center" FontFamily="{StaticResource CapsFont}" FontSize="13.5" FontWeight="ExtraBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="1,0" />
            <Button Style="{StaticResource CardStep}" Content="+" Command="{Binding IncreaseCommand}" ToolTip="Raise" AutomationProperties.Name="{Binding RaiseName}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Kind}" FontFamily="{StaticResource CapsFont}" FontSize="13.5" FontWeight="ExtraBold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                     Visibility="{Binding IsOn, Converter={StaticResource Vis}, ConverterParameter=invert}" />
          <!-- Lined up with the stat's text, under the whole row as on the held card. -->
          <v:RollLine Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Roll}" Margin="25,3,0,1" Visibility="{Binding Converter={StaticResource Vis}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One of the cheapest listings, on one line: price label, the listed item's numbers, how long ago. -->
    <DataTemplate DataType="{x:Type vm:MatchViewModel}">
      <Grid MinHeight="22" Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="62" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <v:ValueLabel Text="{Binding Price}" Tier="{Binding Tier}" Size="Small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Stats}" FontSize="13" Foreground="{StaticResource StatOn}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding Stats}" />
        <TextBlock Grid.Column="2" Text="{Binding Short}" FontSize="12.5" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding InPerson}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The quick peek card: item, price, the cheapest listings, and exactly which stats the price searched
       with. Pinned, it has a close button, its stats can be ticked, and Search runs the search. -->
  <Grid x:Name="Root">
    <Border x:Name="Card" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource GamePanel}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border Style="{StaticResource GamePanelInner}">
        <StackPanel>
          <!-- Header strip: the name centred, the base under it, both in the rarity colour, as in game. -->
          <Border Style="{StaticResource GameStrip}" Padding="0,8,0,7">
            <Grid>
              <StackPanel Margin="44,0">
                <TextBlock x:Name="NameText" Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="19" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
                <TextBlock Text="{Binding HeaderBase}" Style="{StaticResource Heading}" FontWeight="Medium" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Visibility="{Binding HasHeaderBase, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding HeaderDetail}" FontSize="12.5" Foreground="{StaticResource TextDim}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,0"
                           Visibility="{Binding HasHeaderDetail, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Note}" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
              </StackPanel>
              <Border Style="{StaticResource DemoBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,1,0,0" Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
                <TextBlock Text="demo" FontSize="11.5" FontWeight="Bold" />
              </Border>
              <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="0,-2,7,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                      ToolTip="Close" AutomationProperties.Name="Close the price card"
                      Command="{Binding CloseCommand, ElementName=Self}" Visibility="{Binding IsPinned, Converter={StaticResource Vis}}">
                <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Button>
            </Grid>
          </Border>

          <TextBlock Text="{Binding MessageText}" FontSize="15" TextWrapping="Wrap" Margin="14,10,14,12" Visibility="{Binding IsMessage, Converter={StaticResource Vis}}" />

          <!-- The price, centred: the lead, the price as a loot-filter label, then how many and how sure. -->
          <StackPanel x:Name="PriceBlock" Margin="14,11,14,9" Visibility="{Binding HasAnswer, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Answer.Lead}" FontFamily="{StaticResource CapsFont}" FontSize="13.5" Foreground="{StaticResource TextDim}" TextAlignment="Center" TextWrapping="Wrap" />
            <v:ValueLabel x:Name="BigText" Text="{Binding Answer.Big}" Tier="{Binding Answer.Tier}" Size="Large" HorizontalAlignment="Center" Margin="0,5,0,6" Style="{StaticResource Dimmable}" />
            <WrapPanel HorizontalAlignment="Center">
              <TextBlock x:Name="CountBlock" FontSize="14" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="0,0,5,0"
                         Visibility="{Binding Item.PeekShowsCount, Converter={StaticResource Vis}, FallbackValue=Collapsed}"><Run x:Name="CountText" Text="{Binding Answer.Count, Mode=OneWay, StringFormat='{}{0:#,0}'}" Foreground="{StaticResource Text}" FontWeight="Bold" /><Run Text=" for sale ·" /></TextBlock>
              <v:ValueLabel x:Name="PeekLineText" Text="{Binding Item.PeekLine}" Size="Text" VerticalAlignment="Center">
                <v:ValueLabel.Style>
                  <Style TargetType="v:ValueLabel">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextSoft}" />
                    <Setter Property="TextElement.FontSize" Value="14" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Item.IsStale}" Value="True">
                        <Setter Property="TextElement.Foreground" Value="{StaticResource Link}" />
                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Item.PeekLineIsWarning}" Value="True">
                        <Setter Property="TextElement.Foreground" Value="{StaticResource Warn}" />
                        <Setter Property="TextElement.FontWeight" Value="Normal" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </v:ValueLabel.Style>
              </v:ValueLabel>
            </WrapPanel>
          </StackPanel>

          <!-- The cheapest listings of the last search, under the price. Seven rows show; a pinned card
               scrolls to the rest. -->
          <StackPanel x:Name="Listings" Visibility="{Binding Item.HasMatches, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
            <Border Height="1" Background="{StaticResource Edge}" Margin="14,0" />
            <TextBlock Text="{Binding Item.ListingsTitle}" Style="{StaticResource CardHead}" Margin="14,7,14,3" />
            <Border Style="{StaticResource Dimmable}" Margin="14,0,14,4">
              <ScrollViewer x:Name="ListingsScroll" MaxHeight="168" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                  <!-- Held, the card is click-through: no scroll bar, the first rows only. Pinned, it scrolls. -->
                  <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl x:Name="ListingsList" ItemsSource="{Binding Item.Matches}" Focusable="False" AutomationProperties.Name="Cheapest listings" />
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
            <Border Height="1" Background="{StaticResource Edge}" Margin="14,0" />
            <DockPanel Margin="14,7,14,3">
              <!-- A normal copy says nothing of tiers: the game's advanced copy does. -->
              <TextBlock DockPanel.Dock="Right" Text="{Binding Item.AdvancedCopyHint}" FontSize="12.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0"
                         Visibility="{Binding Item.HasAdvancedCopyHint, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
              <StackPanel x:Name="SearchedWith" Orientation="Horizontal">
                <TextBlock Text="Searched with" Style="{StaticResource CardHead}" />
                <Border Style="{StaticResource AccentPill}" Margin="8,0,0,0">
                  <TextBlock FontSize="14"><Run Text="{Binding OnCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Total, Mode=OneWay}" /></TextBlock>
                </Border>
              </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="8,0,8,4" Focusable="False" Grid.IsSharedSizeScope="True" Visibility="{Binding ShowsStaticRows, Converter={StaticResource Vis}}" />
            <ItemsControl x:Name="LiveRowsList" ItemsSource="{Binding LiveRows}" Margin="8,0,8,4" Focusable="False" Grid.IsSharedSizeScope="True" AutomationProperties.Name="Stats in the search"
                          Visibility="{Binding ShowsLiveRows, Converter={StaticResource Vis}}" />
          </StackPanel>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6,14,8">
            <DockPanel>
              <Button x:Name="SearchButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="Search" FontSize="14" MinHeight="0" Height="28" Padding="14,0" Margin="0,0,8,0"
                      Command="{Binding Item.SearchCommand}" Visibility="{Binding ShowsSearch, Converter={StaticResource Vis}}"
                      AutomationProperties.Name="Search" AutomationProperties.HelpText="Runs the search as ticked: the price and the listings above follow"
                      ToolTip="Runs the search as ticked. In a live league it asks the trade site, only now." />
              <StackPanel x:Name="ChangeHint" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                          Visibility="{Binding ShowsChangeKey, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource KeyCap}" BorderThickness="1,1,1,2" Padding="5,0">
                  <TextBlock Text="{Binding ChangeKey}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextSoft}" />
                </Border>
                <TextBlock Text="change search" FontSize="12.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
              <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold" Padding="4,2" Margin="8,-2,-4,-2" VerticalAlignment="Center"
                      Command="{Binding MoreCommand, ElementName=Self}" Visibility="{Binding ShowsMore, Converter={StaticResource Vis}}"
                      AutomationProperties.Name="All filters" AutomationProperties.HelpText="Opens the full price check for this item">
                <Button.ToolTip>
                  <TextBlock><Run Text="Every filter and your own numbers (" /><Run Text="{Binding ChangeKey, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </Button.ToolTip>
                <TextBlock><Run Text="All filters" /><Run Text=" · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding ChangeKey, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
              </Button>
              <TextBlock x:Name="FooterText" Text="{Binding FooterHint}" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>

    <!-- Guide pins over the card (onboarding only), placed in code-behind next to what they explain. -->
    <Canvas x:Name="Pins" IsHitTestVisible="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
