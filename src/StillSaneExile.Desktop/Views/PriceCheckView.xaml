<UserControl x:Class="StillSaneExile.Desktop.Views.PriceCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemViewModel}"
             x:Name="Self"
             Foreground="{StaticResource Text}">
  <UserControl.Resources>
    <Style x:Key="ColumnHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>
  </UserControl.Resources>

  <!-- Price check: the answer first, then the search that produced it, which you can change. -->
  <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12">
    <StackPanel>
      <!-- Item -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,14,16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource DemoBadge}" VerticalAlignment="Top" Margin="12,2,0,0" Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
            <TextBlock Text="DEMO PRICES" FontSize="10.5" FontWeight="Bold" />
          </Border>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Close (Esc)" AutomationProperties.Name="Close the price check"
                  Command="{Binding CloseCommand, ElementName=Self}" Visibility="{Binding CloseCommand, ElementName=Self, Converter={StaticResource Vis}}">
            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </Grid>
      </Border>

      <!-- The answer -->
      <Border Background="{StaticResource Surface3}" Padding="16,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Answer.Lead}" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Answer.Big}" FontSize="30" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,2,0,2" />
            <TextBlock Text="{Binding Answer.Line}" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Visibility="{Binding Answer.HasLine, Converter={StaticResource Vis}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding Answer.HasCount, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Answer.Count}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
            <TextBlock Text="for sale" FontSize="12" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
        <TextBlock Text="{Binding Answer.Note}" FontSize="12.5" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Answer.NoteIsWarning}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>

      <!-- The search -->
      <StackPanel Visibility="{Binding ShowsWorksheet, Converter={StaticResource Vis}}">
        <DockPanel Margin="16,14,16,6" LastChildFill="False">
          <Border DockPanel.Dock="Left" Style="{StaticResource AccentPill}">
            <TextBlock FontSize="13"><Run Text="{Binding OnCount, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" stats in search" /></TextBlock>
          </Border>
          <TextBlock DockPanel.Dock="Left" Text="Fewer stats → more results" FontSize="12.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0" />
          <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Command="{Binding ResetCommand}">
            <TextBlock Text="Reset to my item" TextDecorations="Underline" />
          </Button>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="16,4,16,10">
          <TextBlock Text="Start numbers at" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="2">
            <ItemsControl ItemsSource="{x:Static vm:ItemViewModel.StrictnessChoices}" AutomationProperties.Name="Start numbers at">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StrictnessChoice}">
                  <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}"
                          Command="{Binding DataContext.SetStrictnessCommand, ElementName=Self}" CommandParameter="{Binding Key}">
                    <Button.Tag>
                      <MultiBinding Converter="{StaticResource PillActive}">
                        <Binding Path="Key" />
                        <Binding Path="DataContext.Strictness" ElementName="Self" />
                      </MultiBinding>
                    </Button.Tag>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="128" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="STAT ON YOUR ITEM" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="1" Text="SEARCH FOR AT LEAST" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Grid.Column="2" Text="TIER" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center" />
          </Grid>
        </Border>

        <!-- A unique is always searched by name. -->
        <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Background="{StaticResource AccentTint}" Padding="16,6" Visibility="{Binding IsUnique, Converter={StaticResource Vis}}">
          <Grid MinHeight="36">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="128" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource Accent}">
                <Path Data="M 4,9.2 L 7.6,12.6 L 14,5.6" Stroke="{StaticResource OnAccent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="-1.5" />
              </Border>
              <TextBlock Text="{Binding UniqueNameRow}" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="exact name" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding SearchRows}" Focusable="False" AutomationProperties.Name="Stats in the search">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SearchRowViewModel}">
              <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="16,6">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentTint}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="56" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsOn}" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text}">
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding HasHint, Converter={StaticResource Vis}}" />
                    </StackPanel>
                  </CheckBox>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Dimmed while the stat is unticked, but still in use (changing a number ticks it),
                         so the dimmed numbers keep 4.5:1, and full strength while one has keyboard focus. -->
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0.55" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                          <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Opacity" Value="1" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding DecreaseCommand}" ToolTip="Lower" AutomationProperties.Name="{Binding LowerName}" />
                    <TextBox Text="{Binding Bound, UpdateSourceTrigger=PropertyChanged}" Width="52" Height="32" MinHeight="0" Margin="4,0" Padding="2,0"
                             HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold" AutomationProperties.Name="{Binding BoundName}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                              <Setter Property="BorderThickness" Value="1.5" />
                              <Setter Property="v:Ui.FocusBrush" Value="{StaticResource Text}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding IncreaseCommand}" ToolTip="Raise" AutomationProperties.Name="{Binding RaiseName}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Tier}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
          <WrapPanel>
            <CheckBox IsChecked="{Binding BuyNowOnly}" Content="Buy-now listings only" MinHeight="32" Margin="0,0,18,0" />
            <CheckBox IsChecked="{Binding UseItemLevel}" Content="{Binding ItemLevelLabel}" MinHeight="32" Visibility="{Binding HasItemLevel, Converter={StaticResource Vis}}" />
          </WrapPanel>
        </Border>

        <StackPanel Visibility="{Binding HasListings, Converter={StaticResource Vis}}">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10,16,4">
            <TextBlock Text="CHEAPEST MATCHES" Style="{StaticResource ColumnHead}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Matches}" Margin="16,0" Focusable="False" AutomationProperties.Name="Cheapest matches">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:MatchViewModel}">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1" Padding="0,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Price}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Stats}" FontSize="12.5" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" ToolTip="{Binding Stats}" />
                    <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"><Run Text="{Binding How, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Age, Mode=OneWay}" /></TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Nothing for sale matches. Untick a stat or lower a number." FontSize="13" Foreground="{StaticResource TextDim}" Margin="16,12,16,0" TextWrapping="Wrap"
                     Visibility="{Binding NoMatches, Converter={StaticResource Vis}}" />
        </StackPanel>

        <Grid Margin="16,14,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource PrimaryButton}" Content="Open this search on the trade site" Command="{Binding OpenTradeCommand}"
                  ToolTip="Opens the official trade site in your browser. Copy search lists the filters to set there." />
          <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Copy search" Command="{Binding CopySearchCommand}" FontSize="14" MinHeight="44" Padding="14,0" Margin="8,0,0,0"
                  ToolTip="Copies the filters as text, to set the same search on the trade site." />
        </Grid>
        <TextBlock Text="{Binding SearchStatus}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="16,8,16,0" TextWrapping="Wrap" Visibility="{Binding SearchStatus, Converter={StaticResource Vis}}" />
      </StackPanel>

      <TextBlock Text="Prices are what sellers are asking right now, not what items sold for." FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="16,12,16,14" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
