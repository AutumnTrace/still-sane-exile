<Window x:Class="StillSaneExile.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Still Sane, Exile?"
        Icon="pack://application:,,,/Assets/sse.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <DockPanel>
    <!-- Header: destinations, and league + display currency always visible. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="‹ Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Margin="0,0,8,0" ToolTip="Back keeps your selection, scroll and filters" />
        <TextBlock DockPanel.Dock="Left" Text="Still Sane, Exile?" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Inspect" Command="{Binding GoInspectCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Inspect}" Margin="0,0,4,0" />
        <Button DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Craft" Command="{Binding GoCraftCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Craft}" Margin="0,0,4,0" />
        <Button DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Wealth" Command="{Binding GoWealthCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Wealth}" Margin="0,0,4,0" />
        <Button DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Guide" Command="{Binding GoGuideCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Guide}" Margin="0,0,4,0" />

        <Button DockPanel.Dock="Right" Style="{StaticResource TabButton}" Content="Settings" Command="{Binding GoSettingsCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Settings}" Margin="8,0,0,0" />
        <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
          <Button x:Name="CurrencyButton" Command="{Binding ToggleCurrencyMenuCommand}" ToolTip="Display currency: click to change">
            <TextBlock><Run Text="Show in " Foreground="{StaticResource TextDim}" /><Run Text="{Binding DisplayCurrency, Mode=OneWay}" /></TextBlock>
          </Button>
          <Popup IsOpen="{Binding CurrencyMenuOpen}" PlacementTarget="{Binding ElementName=CurrencyButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding CurrencyChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="{Binding Converter={StaticResource CurrencyName}}"
                            Command="{Binding DataContext.SetCurrencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>
        </Grid>
        <Button DockPanel.Dock="Right" Command="{Binding OpenLeagueSettingCommand}" ToolTip="League: click to change" Margin="8,0,0,0">
          <TextBlock><Run Text="League " Foreground="{StaticResource TextDim}" /><Run Text="{Binding League, Mode=OneWay}" /></TextBlock>
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="10,4"
                Command="{Binding RestartToUpdateCommand}" Visibility="{Binding Updates.IsReady, Converter={StaticResource Vis}}"
                ToolTip="The update is downloaded. It also installs by itself when you close SSE.">
          <TextBlock><Run Text="Update " /><Run Text="{Binding Updates.ReadyVersion, Mode=OneWay}" /><Run Text=" ready · Restart" /></TextBlock>
        </Button>
        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="8,3" VerticalAlignment="Center" BorderThickness="1"
                BorderBrush="{StaticResource Warn}" Visibility="{Binding IsDemo, Converter={StaticResource Vis}}" ToolTip="Demo profile: every price, range and listing here is synthetic test data.">
          <TextBlock Text="{Binding ProfileBadge}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="12" />
        </Border>
      </DockPanel>
    </Border>

    <!-- Status: data sources and the one-read instrumentation. -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="12,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Diagnostics}" FontSize="11" Foreground="{StaticResource TextFaint}" />
        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding PackStatus, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PriceStatus, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
  </DockPanel>
</Window>
