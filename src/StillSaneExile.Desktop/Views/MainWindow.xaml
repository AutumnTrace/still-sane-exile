<Window x:Class="StillSaneExile.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
        xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Still Sane, Exile?"
        Icon="pack://application:,,,/StillSaneExile;component/Assets/sse.ico"
        Width="1440" Height="1000" MinWidth="1260" MinHeight="640"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" FontSize="15"
        Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <DockPanel>
    <!-- Header: destinations, then the demo badge, league and display currency always in view. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Still Sane, Exile?" Style="{StaticResource Heading}" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource Title}" VerticalAlignment="Center" Margin="0,0,20,0" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Style="{StaticResource TabButton}" Content="Price check" Command="{Binding GoInspectCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter='Price check'}" Margin="0,0,2,0" />
          <Button Style="{StaticResource TabButton}" Command="{Binding GoCraftCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Crafting}" Margin="0,0,2,0">
            <TextBlock><Run Text="Crafting" /><Run Text=" later" FontSize="12.5" Foreground="{StaticResource TextFaint}" FontWeight="Normal" /></TextBlock>
          </Button>
          <Button Style="{StaticResource TabButton}" Command="{Binding GoWealthCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter='My wealth'}" Margin="0,0,2,0">
            <TextBlock><Run Text="My wealth" /><Run Text=" later" FontSize="12.5" Foreground="{StaticResource TextFaint}" FontWeight="Normal" /></TextBlock>
          </Button>
          <Button Style="{StaticResource TabButton}" Content="Campaign guide" Command="{Binding GoGuideCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter='Campaign guide'}" />
        </StackPanel>

        <!-- Right side in reading order, so Tab moves left to right across it as well. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Margin="0,0,8,0" Padding="12,0" AutomationProperties.Name="{Binding Updates.ReadyVersion, StringFormat='Restart to install update {0}'}"
                  Command="{Binding RestartToUpdateCommand}" Visibility="{Binding Updates.IsReady, Converter={StaticResource Vis}}"
                  ToolTip="The update is downloaded. It also installs by itself when you close the app.">
            <TextBlock><Run Text="Update " /><Run Text="{Binding Updates.ReadyVersion, Mode=OneWay}" /><Run Text=" ready · Restart" /></TextBlock>
          </Button>
          <Border Style="{StaticResource DemoBadge}" Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
            <TextBlock Text="demo prices" FontSize="12.5" FontWeight="Bold" />
          </Border>
          <Button Command="{Binding OpenLeagueSettingCommand}" ToolTip="Click to change the league" Margin="8,0,0,0">
            <TextBlock><Run Text="League: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding LeagueLabel, Mode=OneWay}" /></TextBlock>
          </Button>
          <Grid Margin="8,0,0,0">
            <Button x:Name="CurrencyButton" Command="{Binding ToggleCurrencyMenuCommand}" PreviewKeyDown="OnCurrencyButtonKeyDown" ToolTip="Click to change the currency prices are shown in"
                    AutomationProperties.Name="{Binding CurrencyWord, StringFormat='Show prices in: {0}'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"><Run Text="Show prices in: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding CurrencyWord, Mode=OneWay}" /></TextBlock>
                <v:CurrencyIcon Currency="{Binding Session.DisplayCurrency}" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Opened from the keyboard, focus moves into the menu: arrows or Tab to choose, Enter to pick,
                 Esc to close. -->
            <Popup x:Name="CurrencyMenu" IsOpen="{Binding CurrencyMenuOpen}" PlacementTarget="{Binding ElementName=CurrencyButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Opened="OnCurrencyMenuOpened" Closed="OnCurrencyMenuClosed">
              <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource EdgeStrong}" BorderThickness="1" Padding="6" Margin="0,4,0,0" MinWidth="180"
                      KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="OnCurrencyMenuKeyDown">
                <ItemsControl x:Name="CurrencyMenuItems" ItemsSource="{Binding CurrencyChoices}" AutomationProperties.Name="Show prices in">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource TabButton}" FontSize="15" MinHeight="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,0"
                              AutomationProperties.Name="{Binding Converter={StaticResource CurrencyName}}"
                              Command="{Binding DataContext.SetCurrencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <Button.Tag>
                          <MultiBinding Converter="{StaticResource PillActive}">
                            <Binding />
                            <Binding Path="DataContext.Session.DisplayCurrency" RelativeSource="{RelativeSource AncestorType=Window}" />
                          </MultiBinding>
                        </Button.Tag>
                        <StackPanel Orientation="Horizontal">
                          <v:CurrencyIcon Currency="{Binding}" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Converter={StaticResource CurrencyName}}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>
          </Grid>
          <Button Content="Settings" Command="{Binding GoSettingsCommand}" Tag="{Binding PageName, Converter={StaticResource Active}, ConverterParameter=Settings}" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status: where prices come from, and the promise that nothing is sent to the game. -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="13.5" Foreground="{StaticResource TextFaint}" Margin="18,0,0,0" />
        <TextBlock DockPanel.Dock="Right" FontSize="13.5" Foreground="{StaticResource TextFaint}" ToolTip="{Binding Diagnostics}">
          <Run Text="Keys sent to the game: " /><Run Text="{Binding KeysSent, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="Bold" /><Run Text=" · Items read: " /><Run Text="{Binding ItemsRead, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="Bold" />
        </TextBlock>
        <TextBlock Text="{Binding FooterStatus}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FooterDetail}" />
      </DockPanel>
    </Border>

    <!-- What's new: once after an update, above every page until "Got it", held back while onboarding is open.
         Only ever here in the main window: never on the HUD, never a dialog, never steals focus. -->
    <Border DockPanel.Dock="Top" Margin="20,20,20,0" Visibility="{Binding ShowWhatsNew, Converter={StaticResource Vis}}">
      <Border Style="{StaticResource Card}" Margin="0" DataContext="{Binding WhatsNew}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource CardLead}" Text="{Binding Lead}" />
            <Button Style="{StaticResource LinkButton}" Content="Open the release on GitHub" Command="{Binding OpenReleaseCommand}"
                    HorizontalAlignment="Left" FontSize="14" Margin="-2,10,0,0" ToolTip="{Binding ReleaseUrl}" />
            <Button Style="{StaticResource GhostButton}" Content="Got it" Command="{Binding DismissCommand}"
                    HorizontalAlignment="Left" MinHeight="34" Padding="18,0" Margin="0,14,0,0"
                    ToolTip="Hides this. You can open it again from Settings." />
          </StackPanel>

          <ScrollViewer Grid.Column="2" MaxHeight="250" MaxWidth="900" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="{Binding Heading}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="0,2,0,6"
                               Visibility="{Binding DataContext.ShowSectionHeadings, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Dot" Text="•" FontSize="14.5" LineHeight="20" Foreground="{StaticResource TextFaint}" />
                            <TextBlock x:Name="Body" Grid.Column="1" v:NoteText.Spans="{Binding Spans}" FontSize="14.5" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" />
                          </Grid>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Paragraph">
                              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="Body" Property="Grid.Column" Value="0" />
                              <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                              <Setter TargetName="Body" Property="Grid.Column" Value="0" />
                              <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="2" />
                              <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                              <Setter TargetName="Body" Property="Foreground" Value="{StaticResource Text}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
  </DockPanel>
</Window>
