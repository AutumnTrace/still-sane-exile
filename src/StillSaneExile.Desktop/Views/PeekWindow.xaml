<Window x:Class="StillSaneExile.Desktop.Views.PeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
        xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PeekViewModel}"
        Title="Still Sane, Exile? HUD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}" FontSize="15"
        Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Room around the card at any scale, for its slide in, its flash and its shadow. Transparent, so it
       never takes a click from the game. -->
  <Border x:Name="Room" Padding="22,20,22,28">
    <Grid x:Name="Motion">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="Slide" />
      </Grid.RenderTransform>
      <Grid>
        <Grid.LayoutTransform>
          <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <!-- Only the shadow: the card draws its own panel. -->
        <Border Background="{StaticResource Panel}" Margin="1">
          <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="14" Direction="270" Opacity="0.55" />
          </Border.Effect>
        </Border>
        <v:PeekCard x:Name="CardView" />
        <!-- The bronze flash: a ring just outside the card with a soft glow, once the card has landed, and
             when the item it shows is checked again. It fades out by itself. -->
        <Border x:Name="Flash" Margin="-3" BorderThickness="3" BorderBrush="{StaticResource Signal}" Opacity="0" IsHitTestVisible="False">
          <Border.Effect>
            <DropShadowEffect Color="{StaticResource SignalColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
          </Border.Effect>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
