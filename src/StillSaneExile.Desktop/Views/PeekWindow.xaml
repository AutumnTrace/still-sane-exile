<Window x:Class="StillSaneExile.Desktop.Views.PeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
        xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PeekViewModel}"
        Title="Still Sane, Exile? HUD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border Padding="12,6,12,18">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
    </Border.LayoutTransform>
    <Grid>
      <Border CornerRadius="12" Background="#F715161A">
        <Border.Effect>
          <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" />
        </Border.Effect>
      </Border>
      <v:PeekCard x:Name="CardView" />
    </Grid>
  </Border>
</Window>
