<UserControl x:Class="StillSaneExile.Desktop.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GuideViewModel}">
  <Grid Margin="20" MaxWidth="1480">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" MinWidth="460" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="5">
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
              Visibility="{Binding Message, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
              Visibility="{Binding Plan.Message, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Plan.Message}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Left: characters, then the zone picker -->
    <DockPanel Grid.Row="1" Grid.Column="0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Style="{StaticResource SectionTitle}" Text="CHARACTERS" Margin="4,0,0,6" />
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" MaxHeight="190" AutomationProperties.Name="Characters">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCharacterCommand}" MinHeight="36" Margin="6,0,0,0" />
          <TextBox Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New character name"
                   ToolTip="Your character's name. Progress is saved per character, on this PC only." />
        </DockPanel>
        <StackPanel Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <Button Style="{StaticResource TextButton}" Content="Remove this character" Command="{Binding RemoveCharacterCommand}" HorizontalAlignment="Left" Margin="2,2,0,0"
                  Visibility="{Binding ConfirmingRemove, Converter={StaticResource Vis}, ConverterParameter=invert}" />
          <StackPanel Visibility="{Binding ConfirmingRemove, Converter={StaticResource Vis}}" Margin="2,8,0,0">
            <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Warn}"><Run Text="Remove " /><Run Text="{Binding SelectedCharacter, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" and everything saved for them?" /></TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="Remove" Command="{Binding RemoveCharacterCommand}" MinHeight="32" />
              <Button Style="{StaticResource TextButton}" Content="Keep" Command="{Binding KeepCharacterCommand}" Margin="12,0,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="PICK YOUR ZONE" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}" AutomationProperties.Name="Zones">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ZoneChoice}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Facts}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Middle: where you are, what to do there, and what was missed -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasPack, Converter={StaticResource Vis}, ConverterParameter=invert}">
          <StackPanel>
            <TextBlock Text="No route pack loaded" Style="{StaticResource CardTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource CardLead}" Text="{Binding PackProblem}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding NeedsCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Add your character" Style="{StaticResource CardTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource CardLead}" FontSize="14" LineHeight="21" Margin="0,8,0,0"
                       Text="Type your character's name on the left and press Add. Then tell SSE where you are with the zone list or Next and Back: it never reads the game, so it only knows what you tell it. Progress is saved per character on this PC and picks up where you left off." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <Grid Margin="20,18,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding ZoneTitle}" FontSize="24" FontWeight="ExtraBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ZoneFacts}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource DemoBadge}" VerticalAlignment="Top" Margin="12,4,0,0" ToolTip="Not checked in game yet. See About this route."
                      Visibility="{Binding IsDraft, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PackBadge}" FontSize="11" FontWeight="Bold" />
              </Border>
            </Grid>
            <TextBlock Text="{Binding LegHint}" FontSize="14" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="20,0,20,14" Visibility="{Binding LegHint, Converter={StaticResource Vis}}" />

            <StackPanel Margin="20,0,20,14" Visibility="{Binding PastRoute, Converter={StaticResource Vis}}">
              <TextBlock Style="{StaticResource CardLead}" Margin="0" Text="This route stops here. Set the act you are in, so the guide knows how far along you are." />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Act" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,10,0" />
                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding ActDownCommand}" ToolTip="Earlier act" AutomationProperties.Name="Earlier act" />
                <TextBlock Text="{Binding Act}" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding ActUpCommand}" ToolTip="Later act" AutomationProperties.Name="Later act" />
              </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GuideStepViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="20,11" Background="Transparent">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource TextButton}" Content="Skip" Padding="0" ToolTip="Leave it for now. Skipped permanent rewards are listed below."
                                Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsOpen, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Skipped" FontSize="12.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource TextButton}" Content="Reopen" Padding="0"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                      </StackPanel>
                      <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding Text}"
                                Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" FontSize="14.5" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                        </StackPanel>
                      </CheckBox>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="20,11" Visibility="{Binding HasSteps, Converter={StaticResource Vis}, ConverterParameter=invert}">
              <TextBlock Text="Nothing to tick off here." FontSize="13" Foreground="{StaticResource TextFaint}" />
            </Border>
            <Button Style="{StaticResource TextButton}" Content="{Binding UndoLabel}" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Margin="20,0,20,6"
                    Visibility="{Binding CanUndo, Converter={StaticResource Vis}}" ToolTip="Takes back your last tick, skip or reopen. Saved, so it works after a restart too." />

            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                  <Button Style="{StaticResource GhostButton}" Content="‹ Back" Command="{Binding BackCommand}" MinHeight="40" IsEnabled="{Binding CanBack}" />
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" MinHeight="40" Margin="8,0,0,0" IsEnabled="{Binding CanNext}">
                    <TextBlock><Run Text="{Binding NextLabel, Mode=OneWay}" /><Run Text="  ›" /></TextBlock>
                  </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"><Run Text="Then  " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding ThenText, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- The build plan's gem steps for the stage the player is at. Later stages stay hidden. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                          ToolTip="Tell SSE when you finish an ascendancy trial. Steps for after it stay hidden until then.">
                <TextBlock Text="Ascendancies done" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding AscendancyDownCommand}" AutomationProperties.Name="One fewer ascendancy" />
                <TextBlock Text="{Binding Ascendancies}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding AscendancyUpCommand}" AutomationProperties.Name="One more ascendancy" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Your gem steps" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding StageLine}" Style="{StaticResource CardLead}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource CardLead}" Margin="0,12,0,0" Visibility="{Binding HasPlan, Converter={StaticResource Vis}, ConverterParameter=invert}"
                       Text="No plan yet. Write your steps in Your build notes and save them. They show up here one stage at a time, and the next one goes on the HUD." />
            <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="14,10" Margin="0,14,0,6" Visibility="{Binding NextGem, Converter={StaticResource Vis}}">
              <TextBlock TextWrapping="Wrap"><Run Text="Next gem   " FontSize="12.5" Foreground="{StaticResource TextFaint}" /><Run Text="{Binding NextGem, Mode=OneWay}" FontSize="16" FontWeight="Bold" /></TextBlock>
            </Border>
            <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlanStepViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9" Background="Transparent">
                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding Text}"
                              Command="{Binding DataContext.Plan.ToggleStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDue}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Text}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding HiddenText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasHidden, Converter={StaticResource Vis}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Missed permanent rewards" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="Lasting rewards you skipped or walked past without ticking. You can go back for them any time." />
            <ItemsControl ItemsSource="{Binding Missed}" Margin="0,8,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MissedRewardViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Reward}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Where}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MissedEmptyText}" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Missed, Converter={StaticResource Vis}, ConverterParameter=invert}" />

            <StackPanel Visibility="{Binding SkippedSteps, Converter={StaticResource Vis}}">
              <TextBlock Text="SKIPPED" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
              <ItemsControl ItemsSource="{Binding SkippedSteps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GuideStepViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,7">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Reopen" Padding="0" Margin="10,0,0,0"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: the HUD lines, then what the route is and how far to trust it -->
    <ScrollViewer Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="On the game screen" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}"
                       Text="Two short lines pinned over the game: where you are, and what comes next. They never take focus or catch clicks, step aside while an item price is showing, and update quietly when you change zone here." />
            <v:GuideHudCard HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding HasHudLines, Converter={StaticResource Vis}}" />
            <TextBlock Text="Add a character to see the lines." FontSize="12.5" Foreground="{StaticResource TextFaint}" Margin="0,12,0,0"
                       Visibility="{Binding HasHudLines, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <CheckBox IsChecked="{Binding HudEnabled}" Content="Show these lines while the game is in front" Margin="0,16,0,0" />
            <Button Style="{StaticResource TextButton}" Content="Preview them over this window for a few seconds" Command="{Binding PreviewHudCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    IsEnabled="{Binding HasHudLines}" />
          </StackPanel>
        </Border>

        <!-- The guide the player follows: a saved link only. Opened in the browser on a click; never fetched or shown here. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="Your build guide" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}"
                       Text="Paste the link to the guide you follow, from Mobalytics or any other site. SSE keeps the link and opens it in your browser when you ask. It never downloads, copies or shows the page itself." />
            <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding HasLink, Converter={StaticResource Vis}}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Open in browser" Command="{Binding OpenLinkCommand}" MinHeight="34" ToolTip="{Binding SavedLink}" />
                  <Button Style="{StaticResource TextButton}" Content="Forget" Command="{Binding ForgetLinkCommand}" Padding="0" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding LinkKind}" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LinkHost}" FontSize="12" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SavedLink}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <DockPanel Margin="0,12,0,0" Visibility="{Binding HasLink, Converter={StaticResource Vis}, ConverterParameter=invert}">
              <Button DockPanel.Dock="Right" Content="Save link" Command="{Binding SaveLinkCommand}" MinHeight="36" Margin="6,0,0,0" />
              <TextBox Text="{Binding LinkDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Build guide link" ToolTip="The guide's address, starting with https://" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- A changed plan waits here until the player accepts it; the old one stays in use. -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource EdgeStrong}" Visibility="{Binding Plan.HasPending, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding PendingLead}" Style="{StaticResource CardLead}" />
            <ItemsControl ItemsSource="{Binding PendingChanges}" Margin="0,10,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlanChangeViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,7">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Sign}" Width="20" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSoft}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="{Binding AcceptLabel}" Command="{Binding AcceptPendingCommand}" FontWeight="SemiBold" />
              <Button Style="{StaticResource TextButton}" Content="{Binding KeepLabel}" Command="{Binding DiscardPendingCommand}" Margin="14,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The player's own notes, read into steps with a preview they can correct before saving. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="Your build notes" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}"
                       Text="Your gem steps in your own words, one per line, typed or pasted from your own notes. SSE turns them into the checklist; nothing is imported from a guide site." />
            <DockPanel Margin="0,12,0,0" Visibility="{Binding EditingNotes, Converter={StaticResource Vis}, ConverterParameter=invert}">
              <Button DockPanel.Dock="Right" Content="Edit notes" Command="{Binding EditNotesCommand}" MinHeight="34" Margin="10,0,0,0" />
              <TextBlock Text="{Binding PlanSummary}" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding EditingNotes, Converter={StaticResource Vis}}">
              <TextBox Text="{Binding NotesDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Height="190" Padding="8,6"
                       VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="13" AutomationProperties.Name="Your build notes" />
              <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"
                         Text="SSE reads lines like cut Entangle, cut support Zenith I, upgrade Entangle to level 5, socket Zenith I into Entangle, move Zenith I: Entangle → Essence Drain, reserve …, respec …. Label stages with Act 2: or after ascendancy:. Optional extras: at Mud Burrow, (level 3 uncut), (needs Essence Drain), (priority: high)." />
              <TextBlock Text="PREVIEW" Style="{StaticResource SectionTitle}" Margin="0,14,0,2" />
              <TextBlock Text="{Binding PreviewSummary}" FontSize="12.5" Foreground="{StaticResource TextDim}" />
              <ItemsControl ItemsSource="{Binding Preview}" Margin="0,6,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:NoteLineViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,6">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" FontSize="11.5" Foreground="{StaticResource TextFaint}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Reading}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasReading, Converter={StaticResource Vis}}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Hint}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{Binding SaveLabel}" Command="{Binding SavePlanCommand}" FontWeight="SemiBold" />
                <Button Style="{StaticResource TextButton}" Content="Cancel" Command="{Binding CancelEditCommand}" Margin="14,0,0,0" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasPack, Converter={StaticResource Vis}}">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource DemoBadge}" ToolTip="Not checked in game yet" Visibility="{Binding IsDraft, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PackBadge}" FontSize="11" FontWeight="Bold" />
              </Border>
              <TextBlock Style="{StaticResource CardTitle}"><Run Text="About this route: " /><Run Text="{Binding PackTitle, Mode=OneWay}" /></TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource CardLead}" Text="{Binding PackSummary}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding PackDetails}" FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding PackProblem}" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding PackProblem, Converter={StaticResource Vis}}" />
            <Button Style="{StaticResource TextButton}" Content="Reload the route pack" Command="{Binding ReloadPackCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip="Reads the pack in the app folder again. A pack that fails its checks is not used; the last good one stays." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
