<UserControl x:Class="StillSaneExile.Desktop.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GuideViewModel}">
  <Grid Margin="20" MaxWidth="1480">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" MinWidth="460" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="5">
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,0,0,16"
              Visibility="{Binding Message, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,0,0,16"
              Visibility="{Binding Plan.Message, Converter={StaticResource Vis}}">
        <TextBlock Text="{Binding Plan.Message}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Left: characters, then the zone picker -->
    <DockPanel Grid.Row="1" Grid.Column="0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Style="{StaticResource SectionTitle}" Text="CHARACTERS" Margin="4,0,0,6" />
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" MaxHeight="190" AutomationProperties.Name="Characters">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Box first, button second: Tab follows reading order. -->
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New character name"
                   ToolTip="Your character's name. Progress is saved per character, on this PC only." />
          <Button Grid.Column="1" Content="Add" AutomationProperties.Name="Add character" Command="{Binding AddCharacterCommand}" MinHeight="36" Margin="6,0,0,0" />
        </Grid>
        <StackPanel Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <Button Style="{StaticResource TextButton}" Content="Remove this character" Command="{Binding RemoveCharacterCommand}" HorizontalAlignment="Left" Margin="2,2,0,0"
                  Visibility="{Binding ConfirmingRemove, Converter={StaticResource Vis}, ConverterParameter=invert}" />
          <StackPanel Visibility="{Binding ConfirmingRemove, Converter={StaticResource Vis}}" Margin="2,8,0,0">
            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Warn}"><Run Text="Remove " /><Run Text="{Binding SelectedCharacter, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" and everything saved for them?" /></TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="Remove" AutomationProperties.Name="{Binding SelectedCharacter, StringFormat='Remove {0}'}" Command="{Binding RemoveCharacterCommand}" MinHeight="32" />
              <Button Style="{StaticResource TextButton}" Content="Keep" AutomationProperties.Name="{Binding SelectedCharacter, StringFormat='Keep {0}'}" Command="{Binding KeepCharacterCommand}" Margin="12,0,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="PICK YOUR ZONE" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}" AutomationProperties.Name="Zones">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ZoneChoice}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Facts}" FontSize="13.5" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Middle: where you are and what to do there, the build's gem steps, then what else the build carries -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasPack, Converter={StaticResource Vis}, ConverterParameter=invert}">
          <StackPanel>
            <TextBlock Text="No route pack loaded" Style="{StaticResource CardTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource CardLead}" Text="{Binding PackProblem}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding NeedsCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Add your character" Style="{StaticResource CardTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource CardLead}" FontSize="15.5" LineHeight="21" Margin="0,8,0,0"
                       Text="Type your character's name on the left and press Add, then paste your build's Path of Building code. Tell SSE where you are with the zone list or Next and Back: it never reads the game, so it only knows what you tell it. Progress is saved per character on this PC and picks up where you left off." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <Grid Margin="20,18,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding ZoneTitle}" FontSize="24" FontWeight="ExtraBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ZoneFacts}" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource DemoBadge}" VerticalAlignment="Top" Margin="12,4,0,0" ToolTip="Not checked in game yet. See About this route."
                      Visibility="{Binding IsDraft, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PackBadge}" FontSize="12.5" FontWeight="Bold" />
              </Border>
            </Grid>
            <TextBlock Text="{Binding LegHint}" FontSize="15.5" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="20,0,20,14" Visibility="{Binding LegHint, Converter={StaticResource Vis}}" />

            <StackPanel Margin="20,0,20,14" Visibility="{Binding PastRoute, Converter={StaticResource Vis}}">
              <TextBlock Style="{StaticResource CardLead}" Margin="0" Text="This route stops here. Set the act you are in, so the guide knows how far along you are." />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Act" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,10,0" />
                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding ActDownCommand}" ToolTip="Earlier act" AutomationProperties.Name="Earlier act" />
                <TextBlock Text="{Binding Act}" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding ActUpCommand}" ToolTip="Later act" AutomationProperties.Name="Later act" />
              </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="Steps here">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GuideStepViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="20,11" Background="Transparent">
                    <!-- The step, then Skip or Reopen on its right: in that order for Tab as well. -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding Text}"
                                Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" FontSize="16" TextWrapping="Wrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                        </StackPanel>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource TextButton}" Content="Skip" Padding="0" ToolTip="Leave it for now. Skipped permanent rewards are listed below." AutomationProperties.Name="{Binding Text, StringFormat='Skip {0}'}"
                                Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsOpen, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Skipped" FontSize="14" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource TextButton}" Content="Reopen" Padding="0" AutomationProperties.Name="{Binding Text, StringFormat='Reopen {0}'}"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsSkipped, Converter={StaticResource Vis}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="20,11" Visibility="{Binding HasSteps, Converter={StaticResource Vis}, ConverterParameter=invert}">
              <TextBlock Text="Nothing to tick off here." FontSize="14.5" Foreground="{StaticResource TextFaint}" />
            </Border>
            <Button Style="{StaticResource TextButton}" Content="{Binding UndoLabel}" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Margin="20,0,20,6"
                    Visibility="{Binding CanUndo, Converter={StaticResource Vis}}" ToolTip="Takes back your last tick, skip or reopen. Saved, so it works after a restart too." />

            <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="20,12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                  <Button Style="{StaticResource GhostButton}" Content="‹ Back" AutomationProperties.Name="Previous stop" Command="{Binding BackCommand}" MinHeight="40" IsEnabled="{Binding CanBack}" />
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" MinHeight="40" Margin="8,0,0,0" IsEnabled="{Binding CanNext}" AutomationProperties.Name="{Binding NextLabel}">
                    <TextBlock><Run Text="{Binding NextLabel, Mode=OneWay}" /><Run Text="  ›" /></TextBlock>
                  </Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14.5"><Run Text="Then  " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding ThenText, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- The build's gem steps for the stage the player is at. Later stages stay hidden. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                          ToolTip="Tell SSE when you finish an ascendancy trial. Steps for after it stay hidden until then.">
                <TextBlock Text="Ascendancies done" FontSize="14" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding AscendancyDownCommand}" AutomationProperties.Name="One fewer ascendancy" />
                <TextBlock Text="{Binding Ascendancies}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding AscendancyUpCommand}" AutomationProperties.Name="One more ascendancy" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Gem steps" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding StageLine}" Style="{StaticResource CardLead}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource CardLead}" Margin="0,12,0,0" Visibility="{Binding HasPlan, Converter={StaticResource Vis}, ConverterParameter=invert}"
                       Text="{Binding EmptyStepsText}" />
            <TextBlock Text="{Binding StepsSource}" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}" />
            <Border Background="{StaticResource Surface3}" CornerRadius="2" Padding="14,10" Margin="0,14,0,6" Visibility="{Binding NextGem, Converter={StaticResource Vis}}">
              <TextBlock TextWrapping="Wrap"><Run Text="Next gem   " FontSize="14" Foreground="{StaticResource TextFaint}" /><Run Text="{Binding NextGem, Mode=OneWay}" FontSize="16" FontWeight="Bold" /></TextBlock>
            </Border>
            <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="Gem steps">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlanStepViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9" Background="Transparent">
                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding Text}"
                              Command="{Binding DataContext.Plan.ToggleStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="15.5" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource TextOff}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDue}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Text}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding HiddenText}" FontSize="14" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasHidden, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding UnstagedText}" FontSize="14" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasUnstaged, Converter={StaticResource Vis}}" />
          </StackPanel>
        </Border>

        <!-- The build's passive tree on GGG's tree. The drawing is mouse only; the buttons and the list of picks
             under it carry everything it shows, for the keyboard and screen readers. -->
        <Border x:Name="BuildTreeCard" Style="{StaticResource Card}" Visibility="{Binding Plan.Tree.HasSpecs, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan.Tree}">
            <TextBlock Text="Passive tree" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource CardLead}" />
            <ItemsControl ItemsSource="{Binding Specs}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="The build's trees"
                          Visibility="{Binding HasSpecChoice, Converter={StaticResource Vis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TreeSpecChoice}">
                  <Button Style="{StaticResource SegmentButton}" Content="{Binding Title}" Tag="{Binding Tag}" Margin="0,0,4,4"
                          AutomationProperties.Name="{Binding Title, StringFormat='Show tree {0}'}"
                          Command="{Binding DataContext.Plan.Tree.ShowSpecCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Warning}" FontSize="14" Foreground="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasWarning, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding NoDataText}" FontSize="14" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasData, Converter={StaticResource Vis}, ConverterParameter=invert}" />

            <StackPanel Visibility="{Binding CanDraw, Converter={StaticResource Vis}}">
              <Grid Height="460" Margin="0,12,0,0">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <v:PassiveTreeView x:Name="BuildTree" Allocation="{Binding Allocation}" Art="{Binding Art}" Hovered="{Binding Hovered}" Selected="{Binding Selected}"
                                     AutomationProperties.Name="Passive tree" ToolTip="{Binding HoveredText}" ToolTipService.IsEnabled="{Binding HasHovered}" ToolTipService.InitialShowDelay="150" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                  <Button Style="{StaticResource StepButton}" Content="‹" ToolTip="Previous point of the build" AutomationProperties.Name="Select the previous point of the build"
                          Command="{x:Static v:PassiveTreeView.PreviousPointCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                  <Button Style="{StaticResource StepButton}" Content="›" ToolTip="Next point of the build" AutomationProperties.Name="Select the next point of the build" Margin="4,0,0,0"
                          Command="{x:Static v:PassiveTreeView.NextPointCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                  <Button Style="{StaticResource StepButton}" Content="−" ToolTip="Zoom out" AutomationProperties.Name="Zoom out of the passive tree" Margin="12,0,0,0"
                          Command="{x:Static v:PassiveTreeView.ZoomOutCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                  <Button Style="{StaticResource StepButton}" Content="+" ToolTip="Zoom in" AutomationProperties.Name="Zoom in on the passive tree" Margin="4,0,0,0"
                          Command="{x:Static v:PassiveTreeView.ZoomInCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                  <Button Style="{StaticResource GhostButton}" Content="Fit" ToolTip="Back to the build's points" AutomationProperties.Name="Fit the passive tree to the build" MinHeight="30" Padding="10,0" Margin="4,0,0,0"
                          Command="{x:Static v:PassiveTreeView.FitBuildCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                  <Button Style="{StaticResource GhostButton}" Content="Whole tree" AutomationProperties.Name="Show the whole passive tree" MinHeight="30" Padding="10,0" Margin="4,0,0,0"
                          Command="{x:Static v:PassiveTreeView.ShowAllCommand}" CommandTarget="{Binding ElementName=BuildTree}" />
                </StackPanel>
              </Grid>
              <!-- The selected node: what the game's tooltip says, plus whether the build takes it and the author's note. -->
              <Border Background="{StaticResource Surface3}" CornerRadius="2" Padding="14,10" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding SelectHint}" FontSize="14" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                             Visibility="{Binding HasSelected, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                  <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding SelectedName}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedFacts}" FontSize="13.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding SelectedStats}" FontSize="14" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"
                               Visibility="{Binding HasSelectedStats, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding SelectedNote}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasSelectedNote, Converter={StaticResource Vis}}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Source}" FontSize="13" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasPicks, Converter={StaticResource Vis}}">
              <TextBlock Text="KEYSTONES AND NOTABLES" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
              <ItemsControl ItemsSource="{Binding Picks}" Focusable="False" AutomationProperties.Name="Keystones and notables the build takes">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:TreePickViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8">
                      <StackPanel>
                        <TextBlock FontSize="15" TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Kind, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextFaint}" /></TextBlock>
                        <TextBlock Text="{Binding Stats}" FontSize="13.5" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Note}" FontSize="13.5" FontStyle="Italic" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="BuildAscendancy" Visibility="{Binding HasAscendancy, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding AscendancyTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Height="260" Visibility="{Binding CanDraw, Converter={StaticResource Vis}}">
                <v:PassiveTreeView Allocation="{Binding Allocation}" Art="{Binding Art}" AscendancyOnly="True" Hovered="{Binding Hovered}" Selected="{Binding Selected}"
                                   AutomationProperties.Name="Ascendancy tree" ToolTip="{Binding HoveredText}" ToolTipService.IsEnabled="{Binding HasHovered}" ToolTipService.InitialShowDelay="150" />
              </Border>
              <ItemsControl ItemsSource="{Binding AscendancyPicks}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="Ascendancy notables the build takes">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:TreePickViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Stats}" FontSize="13.5" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- The build's skills, one skill set at a time: what to cut and what goes with it. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Plan.HasSkills, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="Skills and supports" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="As the build has them. Supports go into the skill on their row." />
            <ItemsControl ItemsSource="{Binding SkillSets}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Skill sets"
                          Visibility="{Binding HasSkillSetChoice, Converter={StaticResource Vis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SkillSetChoice}">
                  <Button Style="{StaticResource SegmentButton}" Content="{Binding Title}" Tag="{Binding Tag}" Margin="0,0,4,4"
                          AutomationProperties.Name="{Binding Title, StringFormat='Show skill set {0}'}"
                          Command="{Binding DataContext.Plan.ShowSkillSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ShownSetStage}" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding ShownSetStage, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Skills}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="Skills and supports">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SkillGroupViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9">
                    <StackPanel>
                      <TextBlock Text="{Binding Skill}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource RarityGem}" TextWrapping="Wrap" />
                      <TextBlock FontSize="14.5" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasSupports, Converter={StaticResource Vis}}"><Run Text="Supports  " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Supports, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
                      <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                      <TextBlock Text="{Binding Notes}" FontSize="14" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding Plan.HasNotes, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="The build's notes" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="As the author wrote them. Lines SSE reads as gem steps are on the list above." />
            <TextBlock Text="{Binding NotesText}" FontSize="15" LineHeight="21" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <Border x:Name="BuildItemsCard" Style="{StaticResource Card}" Visibility="{Binding Plan.HasItems, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Style="{StaticResource CardTitle}"><Run Text="Items: " /><Run Text="{Binding ItemSetTitle, Mode=OneWay}" /></TextBlock>
            <TextBlock Style="{StaticResource CardLead}" Text="The item set the author had open: names and base types only." />
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="Items">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BuildItemViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Slot}" Width="120" FontSize="14" Foreground="{StaticResource TextFaint}" VerticalAlignment="Top" Margin="0,1,0,0" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Missed permanent rewards" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="Lasting rewards you skipped or walked past without ticking. You can go back for them any time." />
            <ItemsControl ItemsSource="{Binding Missed}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="Missed permanent rewards">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MissedRewardViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding Reward}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Where}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MissedEmptyText}" FontSize="14" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Missed, Converter={StaticResource Vis}, ConverterParameter=invert}" />

            <StackPanel Visibility="{Binding SkippedSteps, Converter={StaticResource Vis}}">
              <TextBlock Text="SKIPPED" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
              <ItemsControl ItemsSource="{Binding SkippedSteps}" Focusable="False" AutomationProperties.Name="Skipped steps">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GuideStepViewModel}">
                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,7">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Reopen" Padding="0" Margin="10,0,0,0" AutomationProperties.Name="{Binding Text, StringFormat='Reopen {0}'}"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: the build code, a waiting revision, the HUD lines, then what the route is and how far to trust it -->
    <ScrollViewer Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <!-- The one input of the page: a Path of Building code, read on this PC. Build sites are never opened. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasCharacter, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="Your build" Style="{StaticResource CardTitle}" />
            <Border Background="{StaticResource Surface3}" CornerRadius="2" Padding="12,10" Margin="0,10,0,4" Visibility="{Binding HasBuild, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="{Binding BuildTitle}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BuildFacts}" FontSize="13.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasStats, Converter={StaticResource Vis}}"
                           ToolTip="What Path of Building worked out for the build when the code was made."><Run Text="{Binding StatsLine, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run Text="  in Path of Building" Foreground="{StaticResource TextFaint}" /></TextBlock>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource CardLead}" Margin="0,10,0,0"
                       Text="Copy the code from Path of Building (Import/Export Build, Generate) or from your guide's Path of Building export. SSE reads it on this PC: it never opens the guide site or sends the code anywhere." />
            <TextBlock Text="{Binding PasteLabel}" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,12,0,6" />
            <TextBox Text="{Binding CodeDraft, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" Height="76" Padding="8,6"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="13" AutomationProperties.Name="Path of Building code"
                     ToolTip="One long line of letters and digits. A link to a build site will not do: SSE does not open them." />
            <Button Content="Read build" AutomationProperties.Name="Read the build code" Command="{Binding ReadCodeCommand}" FontWeight="SemiBold" HorizontalAlignment="Left" MinHeight="36" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- A newer code that changes the steps waits here until the player accepts it; the old one stays in use. -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource EdgeStrong}" Visibility="{Binding Plan.HasPending, Converter={StaticResource Vis}}">
          <StackPanel DataContext="{Binding Plan}">
            <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding PendingLead}" Style="{StaticResource CardLead}" />
            <ItemsControl ItemsSource="{Binding PendingChanges}" Margin="0,10,0,0" Focusable="False" AutomationProperties.Name="What the waiting revision changes">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlanChangeViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,7">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Sign}" Width="20" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSoft}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="{Binding AcceptLabel}" Command="{Binding AcceptPendingCommand}" FontWeight="SemiBold" />
              <Button Style="{StaticResource TextButton}" Content="{Binding KeepLabel}" Command="{Binding DiscardPendingCommand}" Margin="14,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="On the game screen" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}"
                       Text="Two short lines pinned over the game: where you are and what to do there, then your build's next gem step or the route's next stop. They never take focus or catch clicks, step aside while an item price is showing, and update quietly when you change zone here." />
            <v:GuideHudCard HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding HasHudLines, Converter={StaticResource Vis}}" />
            <TextBlock Text="Add a character to see the lines." FontSize="14" Foreground="{StaticResource TextFaint}" Margin="0,12,0,0"
                       Visibility="{Binding HasHudLines, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <CheckBox IsChecked="{Binding HudEnabled}" Content="Show these lines while the game is in front" Margin="0,16,0,0" />
            <Button Style="{StaticResource TextButton}" Content="Preview them over this window for a few seconds" Command="{Binding PreviewHudCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    IsEnabled="{Binding HasHudLines}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasPack, Converter={StaticResource Vis}}">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource DemoBadge}" ToolTip="Not checked in game yet" Visibility="{Binding IsDraft, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PackBadge}" FontSize="12.5" FontWeight="Bold" />
              </Border>
              <TextBlock Style="{StaticResource CardTitle}"><Run Text="About this route: " /><Run Text="{Binding PackTitle, Mode=OneWay}" /></TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource CardLead}" Text="{Binding PackSummary}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding PackDetails}" FontSize="13.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding PackProblem}" FontSize="14" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding PackProblem, Converter={StaticResource Vis}}" />
            <Button Style="{StaticResource TextButton}" Content="Reload the route pack" Command="{Binding ReloadPackCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip="Reads the pack in the app folder again. A pack that fails its checks is not used; the last good one stays." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
