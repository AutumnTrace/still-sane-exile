<UserControl x:Class="StillSaneExile.Desktop.Views.GuideHudCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GuideViewModel}"
             Foreground="{StaticResource Text}">
  <!-- The two pinned guide lines: where you are and what to do there, then what comes next.
       The same card is shown on the guide page, so what the player sees there is what the game gets. -->
  <Border Width="360" Style="{StaticResource GamePanel}" Padding="14,9,14,10">
    <StackPanel>
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource DemoBadge}" Padding="5,1" Margin="10,2,0,0" VerticalAlignment="Top"
                ToolTip="Draft route: not checked in game yet" Visibility="{Binding HudIsDraft, Converter={StaticResource Vis}}">
          <TextBlock Text="draft" FontSize="11.5" FontWeight="Bold" />
        </Border>
        <TextBlock FontSize="15" TextTrimming="CharacterEllipsis"><Run Text="{Binding HudZone, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding HudNow, Mode=OneWay}" /></TextBlock>
      </DockPanel>
      <TextBlock FontSize="13.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDim}"><Run Text="{Binding HudThenLabel, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding HudThen, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /></TextBlock>
    </StackPanel>
  </Border>
</UserControl>
