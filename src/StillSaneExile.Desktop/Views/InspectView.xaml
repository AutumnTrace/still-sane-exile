<UserControl x:Class="StillSaneExile.Desktop.Views.InspectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InspectViewModel}">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="460" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
            Visibility="{Binding Message, Converter={StaticResource Vis}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- Left: input and recent items -->
    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
      <StackPanel DockPanel.Dock="Top">
        <Button Style="{StaticResource AccentButton}" Content="Paste item from clipboard" Command="{Binding PasteFromClipboardCommand}" HorizontalAlignment="Stretch"
                ToolTip="Reads the clipboard once. Copy the item in game first (Ctrl+C, or Ctrl+Alt+C for tiers and ranges)." />
        <StackPanel Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="PRACTICE ITEMS (SYNTHETIC)" />
          <ItemsControl ItemsSource="{Binding PracticeItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource LinkButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Content="{Binding Label}"
                        Command="{Binding DataContext.LoadPracticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Practice the HUD: load an item, then hold the peek key with this window in front." FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="4,6,0,0" />
        </StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="RECENT (THIS SESSION ONLY)" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Recent}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}"><Run Text="{Binding Rarity, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CapturedAt, Mode=OneWay}" /></TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Empty state -->
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" VerticalAlignment="Top"
            Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=invert}">
      <StackPanel>
        <TextBlock Text="No item yet" FontSize="18" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,6,0,0"
                   Text="In game, hover an item and hold the peek key (default Ctrl+C: the game copies, this app reads the copy once). Or copy an item and press Paste. Advanced copy (Ctrl+Alt+C) gives tiers and exact ranges." />
      </StackPanel>
    </Border>

    <!-- Middle: item facts -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"
                  DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource Vis}}">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BaseLine}" FontSize="15" Foreground="{StaticResource TextDim}" Visibility="{Binding BaseLine, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding ClassLine}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding CopyLabel}" FontSize="12" Foreground="{StaticResource TextFaint}" Visibility="{Binding HasRows, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding StatesLabel}" FontSize="12" Foreground="{StaticResource Warn}" Visibility="{Binding StatesLabel, Converter={StaticResource Vis}}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PhysicalDps, Converter={StaticResource Vis}}">
              <TextBlock Text="Physical DPS " Foreground="{StaticResource TextDim}" />
              <TextBlock Text="{Binding PhysicalDps}" FontWeight="SemiBold" />
              <TextBlock Text="  (displayed average hit × attacks per second; nothing reapplied)" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Properties}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="12"><Run Text="{Binding Key, Mode=OneWay}" Foreground="{StaticResource TextFaint}" /><Run Text=": " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="ROLL QUALITY" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
            <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                       Text="How close each roll is to the best of its range. Bars appear only when range, value and direction are verified for that exact line." />
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ModRowFull}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding FlavourText, Converter={StaticResource Vis}}">
          <ItemsControl ItemsSource="{Binding FlavourText}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontStyle="Italic" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding Unparsed, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="LINES NOT UNDERSTOOD (KEPT AS-IS)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Unparsed}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: price evidence and comparison worksheet -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="PRICE" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="⚠ " Foreground="{StaticResource Warn}" FontSize="16" Visibility="{Binding Selected.Price.Uncertain, Converter={StaticResource Vis}}" />
              <TextBlock Text="{Binding Selected.Price.Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Selected.Price.Detail}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Selected.PriceWarnings}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding Selected.ShowsComparables, Converter={StaticResource Vis}}">
              <TextBlock Text="YOUR COMPARABLES (ASKING PRICES, PRIVATE)" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding Selected.Comparables}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Remove" FontSize="12"
                                Command="{Binding DataContext.RemoveComparableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding Seeded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <StackPanel>
                          <TextBlock><Run Text="{Binding Price, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Converted, Mode=OneWay}" Foreground="{StaticResource TextDim}" /><Run Text="  · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Seller, Mode=OneWay}" /></TextBlock>
                          <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}"><Run Text="{Binding Age, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Tags, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Notes, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="ADD A COMPARABLE YOU SAW ON THE TRADE SITE" Style="{StaticResource SectionTitle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Asking price" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextDim}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                  <TextBox Width="80" Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />
                  <ItemsControl ItemsSource="{Binding CurrencyChoices}" Margin="6,0,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource TabButton}" Padding="8,3" Margin="0,0,4,0" Content="{Binding}"
                                Command="{Binding DataContext.SetNewCurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <Button.Tag>
                            <MultiBinding Converter="{StaticResource PillActive}">
                              <Binding />
                              <Binding Path="DataContext.NewCurrency" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                          </Button.Tag>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Seller" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding NewSeller, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional. Each seller counts once; unknown sellers cannot raise confidence." />
                <TextBlock Grid.Row="2" Text="Listing link" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding NewLink, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional https:// link to the listing" />
                <TextBlock Grid.Row="3" Text="Match notes" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Add comparable" Command="{Binding AddComparableCommand}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding Selected.ShowsWorksheet, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="COMPARISON WORKSHEET" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
            <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Text="Choose what a comparable must match. AND rows are required; OPT rows form one alternatives group. Nothing broadens itself." />
            <ItemsControl ItemsSource="{Binding Selected.MarketControls}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{StaticResource TextDim}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Selected.WorksheetRows}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}">
                      <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding KindLabel, StringFormat='  {0}', Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextFaint}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Actual}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="{StaticResource TextDim}" />
                    <TextBox Grid.Column="3" Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Minimum" />
                    <TextBox Grid.Column="4" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Maximum" />
                    <Button Grid.Column="5" Padding="4,2" FontSize="11" Content="{Binding MatchLabel}" Margin="0,0,4,0" ToolTip="Match type: min / range / max"
                            Command="{Binding DataContext.CycleMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Grid.Column="6" Padding="4,2" FontSize="11" Content="{Binding GroupLabel}" ToolTip="AND = required, OPT = one of the alternatives"
                            Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Selected.WorksheetWarnings}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="IF YOU FIND TOO FEW LISTINGS, RELAX ONE THING" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Selected.Relaxations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource LinkButton}" HorizontalContentAlignment="Left" Content="{Binding Description}" FontSize="12"
                          Command="{Binding DataContext.ApplyRelaxationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,10,0,0">
              <Button Style="{StaticResource AccentButton}" Content="Open official trade site" Command="{Binding OpenTradeCommand}" Margin="0,0,8,6"
                      ToolTip="Opens pathofexile.com/trade2 in your browser. Set the filters from this worksheet there." />
              <Button Content="Copy worksheet" Command="{Binding CopyInstructionsCommand}" Margin="0,0,8,6" />
              <Button Content="Plan a craft from this item" Command="{Binding OpenCraftCommand}" Margin="0,0,8,6" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
