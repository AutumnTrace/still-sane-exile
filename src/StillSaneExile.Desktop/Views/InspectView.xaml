<UserControl x:Class="StillSaneExile.Desktop.Views.InspectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InspectViewModel}">
  <Grid Margin="20" MaxWidth="1480">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="600" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" MinWidth="300" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Warn}" BorderThickness="1" Padding="12,8" Margin="0,0,0,16"
            Visibility="{Binding Message, Converter={StaticResource Vis}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- Left: paste, practice items, and what was checked this session -->
    <DockPanel Grid.Row="1" Grid.Column="0">
      <StackPanel DockPanel.Dock="Top">
        <Button Content="Paste an item" Command="{Binding PasteFromClipboardCommand}" MinHeight="44" FontSize="15.5" FontWeight="SemiBold"
                ToolTip="Reads the clipboard once. Copy the item in game first (Ctrl+C, or Ctrl+Alt+C for tiers and ranges)." />
        <StackPanel Visibility="{Binding IsDemo, Converter={StaticResource Vis}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="PRACTICE ITEMS (MADE UP)" />
          <ItemsControl ItemsSource="{Binding PracticeItems}" Focusable="False" AutomationProperties.Name="Practice items">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource LinkButton}" Content="{Binding Label}" FontSize="14.5" Padding="4,3" HorizontalAlignment="Stretch"
                        Command="{Binding DataContext.LoadPracticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="CHECKED THIS SESSION" />
        <TextBlock Text="Nothing yet." FontSize="14" Foreground="{StaticResource TextFaint}" Margin="4,0,0,0" Visibility="{Binding Recent.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Recent}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Checked this session">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <StackPanel>
              <TextBlock Text="{Binding ListTitle}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
              <TextBlock Text="{Binding ListSubtitle}" FontSize="13.5" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Middle: the price check -->
    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
            Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=invert}">
      <StackPanel>
        <TextBlock Text="No item yet" Style="{StaticResource CardTitle}" FontSize="18" />
        <TextBlock Style="{StaticResource CardLead}" FontSize="15.5" LineHeight="22" Margin="0,8,0,0"
                   Text="In game, hover an item and hold Ctrl+C: the game copies it and the price shows while you hold. Move onto the card to keep it open. Or copy an item and press Paste an item. A Ctrl+Alt+C copy also shows tiers and ranges." />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" Focusable="False">
      <v:PriceCheckView DataContext="{Binding Selected}" Margin="0,0,0,8" VerticalAlignment="Top" />
    </ScrollViewer>

    <!-- Right: rolls and prices written down -->
    <ScrollViewer Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" Focusable="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" DataContext="{Binding Selected}" Visibility="{Binding HasRollRows, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="How good are your rolls?" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="Tier 1 is the best a stat can roll on this kind of item. Each bar shows where your roll sits between the lowest and highest number of its tier." />
            <ItemsControl ItemsSource="{Binding RollRows}" Margin="0,10,0,0" Focusable="False" AutomationProperties.Name="How good are your rolls?">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RollRowViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,10" Background="Transparent" ToolTip="{Binding Details}">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TierText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextSoft}" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding Text}" FontSize="15" Foreground="{StaticResource StatOn}" TextWrapping="Wrap" />
                      </DockPanel>
                      <Border Height="6" Background="{StaticResource Track}" Margin="0,6,0,0" ClipToBounds="True" Visibility="{Binding HasBar, Converter={StaticResource Vis}}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FillWidth}" />
                            <ColumnDefinition Width="{Binding RestWidth}" />
                          </Grid.ColumnDefinitions>
                          <Border Background="{StaticResource BarFill}" Visibility="{Binding HasFill, Converter={StaticResource Vis}}" />
                          <Border Width="3" HorizontalAlignment="Right" Background="{StaticResource BarFill}" Visibility="{Binding HasMarker, Converter={StaticResource Vis}}" />
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Note}" FontSize="13.5" TextWrapping="Wrap" Margin="0,5,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NoteIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Hint}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding OpenSlotsLine}" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding OpenSlotsLine, Converter={StaticResource Vis}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding Selected.ShowsComparables, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Prices you wrote down" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="Saved by you from the trade site. Only you see these." />
            <ItemsControl ItemsSource="{Binding Selected.Comparables}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="Prices you wrote down">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ComparableViewModel}">
                  <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="0,8" Background="Transparent" ToolTip="{Binding Tags}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Remove" FontSize="13.5" Padding="0" Margin="10,0,0,0"
                              AutomationProperties.Name="{Binding Price, StringFormat='Remove the price {0}'}"
                              Command="{Binding DataContext.RemoveComparableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                              Visibility="{Binding Seeded, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                      <TextBlock DockPanel.Dock="Right" FontSize="14.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run Text="{Binding Seller, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Age, Mode=OneWay}" /></TextBlock>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <v:ValueLabel Text="{Binding Price}" Size="Text" TextElement.FontSize="15" TextElement.FontWeight="Bold" VerticalAlignment="Center" />
                        <v:ValueLabel Text="{Binding Converted}" Size="Text" TextElement.FontSize="13.5" TextElement.Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nothing written down yet." FontSize="14" Foreground="{StaticResource TextFaint}" Margin="0,8,0,0"
                       Visibility="{Binding Selected.Comparables.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Selected.PriceWarnings}" Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Price warnings">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="13.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource GhostButton}" Content="Write down a price" Command="{Binding ToggleAddFormCommand}" HorizontalAlignment="Stretch" FontSize="15" Margin="0,10,0,0"
                    Visibility="{Binding ShowAddForm, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowAddForm, Converter={StaticResource Vis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Asking price" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextDim}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                  <TextBox Width="72" Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Asking price" />
                  <Border Margin="8,0,0,0">
                    <ItemsControl ItemsSource="{Binding CurrencyChoices}" Focusable="False" AutomationProperties.Name="Asking price currency">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource SegmentButton}" Padding="6,0" MinHeight="36" Margin="0,0,2,0" ToolTip="{Binding Converter={StaticResource CurrencyName}}"
                                  AutomationProperties.Name="{Binding Converter={StaticResource CurrencyName}}"
                                  Command="{Binding DataContext.SetNewCurrencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Tag>
                              <MultiBinding Converter="{StaticResource PillActive}">
                                <Binding />
                                <Binding Path="DataContext.NewCurrency" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                              </MultiBinding>
                            </Button.Tag>
                            <v:CurrencyIcon Currency="{Binding}" Width="22" Height="22" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Seller" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding NewSeller, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seller"
                         ToolTip="Optional. Each seller counts once; prices without a seller can't make the price guess surer." />
                <TextBlock Grid.Row="2" Text="Listing link" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding NewLink, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Listing link" ToolTip="Optional https:// link to the listing" />
                <TextBlock Grid.Row="3" Text="Notes" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextDim}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Notes" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="96,8,0,0">
                <Button Content="Save price" Command="{Binding AddComparableCommand}" FontWeight="SemiBold" />
                <Button Style="{StaticResource TextButton}" Content="Cancel" Command="{Binding ToggleAddFormCommand}" Margin="12,0,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" DataContext="{Binding Selected}" Visibility="{Binding Unparsed, Converter={StaticResource Vis}}">
          <StackPanel>
            <TextBlock Text="Lines not understood" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource CardLead}" Text="Kept exactly as copied. They are not part of the price or the search." />
            <ItemsControl ItemsSource="{Binding Unparsed}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="Lines not understood">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
