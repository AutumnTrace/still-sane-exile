<Window x:Class="StillSaneExile.Desktop.Views.PriceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
        xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ItemViewModel}"
        Title="Still Sane, Exile? price check"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
  <!-- Over the game after a peek (F3): change the search; results update as you go. Esc closes it. -->
  <Grid Margin="16,8,16,28">
    <Border CornerRadius="12" Background="{StaticResource Surface2}">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="44" ShadowDepth="18" Direction="270" Opacity="0.6" />
      </Border.Effect>
    </Border>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
      <v:PriceCheckView x:Name="View" Width="600" />
    </ScrollViewer>
  </Grid>
</Window>
