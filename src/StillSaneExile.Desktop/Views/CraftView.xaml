<UserControl x:Class="StillSaneExile.Desktop.Views.CraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StillSaneExile.Desktop.ViewModels"
             xmlns:v="clr-namespace:StillSaneExile.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CraftViewModel}"
             x:Name="Self"
             Foreground="{StaticResource Text}"
             PreviewMouseRightButtonDown="OnRightButtonDown"
             PreviewKeyDown="OnPreviewKeyDown"
             MouseMove="OnMouseMove"
             MouseLeave="OnMouseLeave">
  <UserControl.Resources>
    <!-- The game's colours for the stats of a crafted item: an essence's stat, a fractured one, and the red of
         "Corrupted". Only this page draws them. -->
    <SolidColorBrush x:Key="EssenceStat" Color="#B8DAF2" />
    <SolidColorBrush x:Key="FracturedStat" Color="#C2B07A" />
    <SolidColorBrush x:Key="Corrupted" Color="#E05050" />

    <Style x:Key="ColumnTitle" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- An orb tile: the game's picture, its short name, how often it was used. An orb that can't be used now
         is faded but still clickable: it says why. The orb in hand has a gold frame. -->
    <Style x:Key="OrbTile" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#15120D" />
      <Setter Property="MinHeight" Value="86" />
      <Setter Property="Padding" Value="4,6,4,6" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanUse}" Value="False">
          <Setter Property="Opacity" Value="0.42" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHeld}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSoft}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="BorderThickness" Value="1.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The item, drawn as the game draws a tooltip. It is a button only while an orb is in hand: clicking it
         uses the orb. -->
    <Style x:Key="ItemButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="panel" Style="{StaticResource GamePanel}">
                <Border Style="{StaticResource GamePanelInner}">
                  <ContentPresenter />
                </Border>
              </Border>
              <Border x:Name="ring" BorderBrush="{StaticResource Text}" BorderThickness="2" Margin="-3" Visibility="Hidden" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Cursor" Value="Hand" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsEnabled" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="panel" Property="BorderBrush" Value="{StaticResource Accent}" />
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelTab" TargetType="Button" BasedOn="{StaticResource TabButton}">
      <Setter Property="FontFamily" Value="{StaticResource CapsFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root" Background="Transparent">
    <!-- A live profile: there is no stat data for it yet. -->
    <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left" Visibility="{Binding NoData, Converter={StaticResource Vis}}">
      <TextBlock Text="Crafting" Style="{StaticResource Heading}" FontSize="28" FontWeight="ExtraBold" />
      <TextBlock Text="{Binding NoDataText}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,12,0,0" FontSize="15" LineHeight="22" />
    </StackPanel>

    <DockPanel Visibility="{Binding HasData, Converter={StaticResource Vis}}">
      <!-- The bench: the base, its item level, undo and start over. -->
      <Border DockPanel.Dock="Top" Background="#120F0C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
        <!-- Two columns rather than a dock, so Tab reads left to right. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <WrapPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Base" FontSize="15" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding BaseName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" />
            <TextBlock Text="Item level" FontSize="15" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding LowerItemLevelCommand}" AutomationProperties.Name="Lower the item level" ToolTip="Lower" />
            <TextBox Text="{Binding ItemLevel, UpdateSourceTrigger=PropertyChanged}" Width="56" Height="32" MinHeight="0" Margin="4,0" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="16"
                     AutomationProperties.Name="Item level" />
            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding RaiseItemLevelCommand}" AutomationProperties.Name="Raise the item level" ToolTip="Raise" />
            <TextBlock Text="{Binding ItemLevelNote}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0,18,0" />
            <Border Style="{StaticResource DemoBadge}" ToolTip="The stats, tiers and ranges are the game's own for a Siege Crossbow in patch 0.5.5, not checked in the game. How often each one rolls is made up: the game files don't say, so every chance here is practice. In the demo the prices are made up too. What each orb and omen does has not been checked in the game yet.">
              <TextBlock Text="practice · made-up odds" FontSize="12" FontWeight="Bold" />
            </Border>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Content="Undo" Command="{Binding UndoCommand}" FontFamily="{StaticResource CapsFont}" FontSize="16" FontWeight="Bold" MinHeight="38"
                    AutomationProperties.HelpText="Goes back to before the last click" />
            <Button Style="{StaticResource GhostButton}" Content="Start over" Command="{Binding StartOverClickedCommand}" FontFamily="{StaticResource CapsFont}" FontSize="16" FontWeight="Bold" MinHeight="38" Margin="8,0,0,0"
                    AutomationProperties.HelpText="A fresh Normal base; the stats you marked are kept" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20" MaxWidth="1500">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="390" />
          </Grid.ColumnDefinitions>

          <!-- Orbs and omens -->
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <TextBlock Text="orb grade" Style="{StaticResource Heading}" FontSize="14" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ItemsControl ItemsSource="{Binding Grades}" Focusable="False" AutomationProperties.Name="Orb grade">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GradeViewModel}">
                    <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}" Tag="{Binding Active}" ToolTip="{Binding Tip}" Margin="0,0,2,0"
                            Command="{Binding Pick}" CommandParameter="{Binding Grade}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Tip}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OrbGroupViewModel}">
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ColumnTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Orbs}" Focusable="False" AutomationProperties.Name="{Binding Title}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OrbViewModel}">
                          <Button Style="{StaticResource OrbTile}" Margin="0,0,6,6" Command="{Binding ClickCommand}" ToolTip="{Binding Tip}"
                                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Tip}">
                            <Grid>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                <v:CurrencyIcon Currency="{Binding Id}" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Short}" FontFamily="{StaticResource CapsFont}" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                              </StackPanel>
                              <TextBlock Text="{Binding Count, StringFormat='×{0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Visibility="{Binding HasCount, Converter={StaticResource Vis}}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Omens" Style="{StaticResource ColumnTitle}" VerticalAlignment="Bottom" />
              <TextBlock Text="on until the next orb they change" Style="{StaticResource Faint}" Margin="8,0,0,1" VerticalAlignment="Bottom" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Omens}" Focusable="False" AutomationProperties.Name="Omens">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OmenViewModel}">
                  <Button Margin="0,0,6,6" MinHeight="50" Padding="6,4" HorizontalContentAlignment="Stretch" Command="{Binding ToggleCommand}"
                          AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Title}" ToolTip="{Binding Name}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Tag" Value="" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOn}" Value="True">
                            <Setter Property="Tag" Value="active" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <v:CurrencyIcon Currency="{Binding Id}" Width="30" Height="30" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The item -->
          <StackPanel Grid.Column="2" MaxWidth="500" HorizontalAlignment="Stretch">
            <Border Padding="14,9" Margin="0,0,0,14">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Surface2}" />
                  <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                      <Setter Property="Background" Value="#2A1410" />
                      <Setter Property="BorderBrush" Value="#7A3A2A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Message}" FontSize="15.5" TextWrapping="Wrap" LineHeight="21" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>

            <Button x:Name="ItemCard" Style="{StaticResource ItemButton}" Command="{Binding UseHeldCommand}" AutomationProperties.Name="{Binding UseOnItemName}">
              <StackPanel>
                <Border Style="{StaticResource GameStrip}" Padding="16,11,16,9">
                  <StackPanel>
                    <TextBlock Text="{Binding ItemName}" Style="{StaticResource Heading}" FontSize="22" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Visibility="{Binding HasItemName, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding BaseLine}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Heading}">
                          <Setter Property="FontSize" Value="21" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItemName}" Value="True">
                              <Setter Property="FontSize" Value="17" />
                              <Setter Property="FontWeight" Value="Medium" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <StackPanel Margin="18,12,18,6">
                  <TextBlock TextAlignment="Center" FontSize="15.5"><Run Text="Physical Damage: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Weapon.Low, Mode=OneWay}" FontWeight="Bold" /><Run Text="–" FontWeight="Bold" /><Run Text="{Binding Weapon.High, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                  <TextBlock TextAlignment="Center" FontSize="15.5"><Run Text="Attacks per Second: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Weapon.AttacksPerSecond, Mode=OneWay}" FontWeight="Bold" /><Run Text=" · Physical DPS: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding Weapon.PhysicalDps, Mode=OneWay}" FontWeight="ExtraBold" Foreground="{StaticResource OnAccentSoft}" /></TextBlock>
                  <TextBlock TextAlignment="Center" FontSize="15.5"><Run Text="Item Level: " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding ItemLevel, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                  <Border Height="1" Background="{StaticResource Edge}" Margin="0,8,0,6" />
                  <TextBlock Text="{Binding Implicit}" TextAlignment="Center" FontSize="15.5" Foreground="{StaticResource StatOn}" TextWrapping="Wrap" Visibility="{Binding Implicit, Converter={StaticResource Vis}}" />
                  <Border Height="1" Background="{StaticResource Edge}" Margin="0,6,0,4" Visibility="{Binding Implicit, Converter={StaticResource Vis}}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Sides}" Margin="12,0,12,6" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CraftSideViewModel}">
                      <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="6,0,0,3">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="13.5" Foreground="{StaticResource TextDim}" />
                          <TextBlock Text="{Binding Count}" Style="{StaticResource Faint}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CraftRowViewModel}">
                              <Border MinHeight="34" Padding="8,4" Margin="0,0,0,2">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsFresh}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentTint}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Text}" FontSize="16" LineHeight="21" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource StatOn}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsEssence}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource EssenceStat}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding IsFractured}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource FracturedStat}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Border Padding="5,0,5,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasTag, Converter={StaticResource Vis}}" BorderThickness="1">
                                      <Border.Style>
                                        <Style TargetType="Border">
                                          <Setter Property="Background" Value="{StaticResource Accent}" />
                                          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                          <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccent}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEssence}" Value="True">
                                              <Setter Property="Background" Value="Transparent" />
                                              <Setter Property="BorderBrush" Value="#4A6A80" />
                                              <Setter Property="TextElement.Foreground" Value="{StaticResource EssenceStat}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFractured}" Value="True">
                                              <Setter Property="Background" Value="Transparent" />
                                              <Setter Property="BorderBrush" Value="#6A5E3A" />
                                              <Setter Property="TextElement.Foreground" Value="{StaticResource FracturedStat}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Border.Style>
                                      <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource CapsFont}" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource CapsFont}" FontSize="13.5" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextAlignment="Center" FontSize="15.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="12,0,12,14" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                  <Run Text="No stats yet. Start with a " /><Run Text="Transmutation" FontWeight="Bold" Foreground="{StaticResource Text}" /><Run Text=", an " /><Run Text="Alchemy" FontWeight="Bold" Foreground="{StaticResource Text}" /><Run Text=" or an " /><Run Text="Essence" FontWeight="Bold" Foreground="{StaticResource Text}" /><Run Text="." />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding CorruptionLines}" Focusable="False" Margin="0,0,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="15.5" Foreground="{StaticResource Corrupted}" TextAlignment="Center" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Corrupted" Style="{StaticResource Heading}" FontSize="17" Foreground="{StaticResource Corrupted}" TextAlignment="Center" Margin="0,0,0,12"
                           Visibility="{Binding IsCorrupted, Converter={StaticResource Vis}}" />
              </StackPanel>
            </Button>

            <WrapPanel Margin="0,12,0,0">
              <TextBlock Style="{StaticResource Faint}" Margin="0,0,16,4"><Run Text="■" Foreground="{StaticResource StatOn}" /><Run Text=" rolled stat" /></TextBlock>
              <TextBlock Style="{StaticResource Faint}" Margin="0,0,16,4"><Run Text="■" Foreground="{StaticResource EssenceStat}" /><Run Text=" essence stat" /></TextBlock>
              <TextBlock Style="{StaticResource Faint}" Margin="0,0,16,4"><Run Text="■" Foreground="{StaticResource FracturedStat}" /><Run Text=" fractured: locked" /></TextBlock>
              <TextBlock Style="{StaticResource Faint}" Margin="0,0,16,4"><Run Text="▢" Foreground="{StaticResource Accent}" /><Run Text=" new this click" /></TextBlock>
            </WrapPanel>
          </StackPanel>

          <!-- What I want, the stat pool, the history -->
          <Border Grid.Column="4" Background="#13110E" BorderBrush="{StaticResource Edge}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PanelTab}" Content="What I want" Command="{Binding ShowTabCommand}" CommandParameter="want"
                        Tag="{Binding Tab, Converter={StaticResource Active}, ConverterParameter=want}" />
                <Button Grid.Column="1" Style="{StaticResource PanelTab}" Content="Mod pool" Command="{Binding ShowTabCommand}" CommandParameter="pool"
                        Tag="{Binding Tab, Converter={StaticResource Active}, ConverterParameter=pool}" />
                <Button Grid.Column="2" Style="{StaticResource PanelTab}" Content="History" Command="{Binding ShowTabCommand}" CommandParameter="history"
                        Tag="{Binding Tab, Converter={StaticResource Active}, ConverterParameter=history}" />
              </Grid>
              <Border Height="1" Background="{StaticResource Edge}" />

              <!-- What I want: marked stats with the tier wanted, and the odds of the next orbs. -->
              <StackPanel Margin="16,14" Visibility="{Binding IsWantTab, Converter={StaticResource Vis}}">
                <TextBlock FontSize="15" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"><Run Text="Mark stats you want in " /><Run Text="Mod pool" FontWeight="Bold" Foreground="{StaticResource Text}" /><Run Text=". Odds update after every click." /></TextBlock>
                <ItemsControl ItemsSource="{Binding Wants}" Focusable="False" Margin="0,12,0,0" AutomationProperties.Name="Stats you want">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WantViewModel}">
                      <Border Background="#1A1712" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                        <StackPanel>
                          <DockPanel>
                            <Border DockPanel.Dock="Right" Padding="6,0,6,1" BorderThickness="1" VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource TextFaint}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnItem}" Value="True">
                                      <Setter Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                                      <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccentSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMet}" Value="True">
                                      <Setter Property="Background" Value="{StaticResource Accent}" />
                                      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                      <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccent}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding Status}" FontFamily="{StaticResource CapsFont}" FontSize="13" FontWeight="ExtraBold" />
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource StatOn}" TextWrapping="Wrap" Margin="0,0,8,0" />
                          </DockPanel>
                          <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="tier" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <ItemsControl ItemsSource="{Binding Levels}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type vm:WantLevelViewModel}">
                                    <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}" Tag="{Binding Active}" Command="{Binding Pick}" MinHeight="28" FontSize="13" Margin="0,0,3,0"
                                            AutomationProperties.Name="{Binding Name}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="remove" Command="{Binding Remove}" Padding="0,2"
                                    AutomationProperties.Name="{Binding RemoveName}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="10" Visibility="{Binding NoWants, Converter={StaticResource Vis}}">
                  <TextBlock Text="Nothing marked yet." Style="{StaticResource Faint}" FontSize="15" />
                </Border>

                <TextBlock Text="Chance to hit one" Style="{StaticResource Heading}" FontSize="16" FontWeight="ExtraBold" Margin="0,14,0,4" />
                <ItemsControl ItemsSource="{Binding Odds}" Focusable="False" AutomationProperties.Name="Chance to hit one">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OddsViewModel}">
                      <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource OnAccentSoft}"><Run Text="{Binding Chance, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Kind, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextFaint}" /></TextBlock>
                          <TextBlock Text="{Binding Label}" FontSize="15.5" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding NoOddsText}" Style="{StaticResource Faint}" FontSize="15" Visibility="{Binding NoOdds, Converter={StaticResource Vis}}" />
              </StackPanel>

              <!-- Mod pool: each stat's chance to be the next one added; tick to want it. -->
              <StackPanel Margin="12,10,12,14" Visibility="{Binding IsPoolTab, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PoolNote}" FontSize="14.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="4,0,4,8" />
                <ItemsControl ItemsSource="{Binding Pool}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PoolSideViewModel}">
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" Margin="4,0,4,4" />
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{Binding Title}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PoolRowViewModel}">
                              <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1" Padding="4,4">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <CheckBox IsChecked="{Binding IsWanted}" AutomationProperties.Name="{Binding WantName}" VerticalContentAlignment="Center">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Label}" FontSize="15" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource StatOn}" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding OnItem}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                      <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{StaticResource TextFaint}" />
                                    </StackPanel>
                                  </CheckBox>
                                  <TextBlock Grid.Column="1" Text="{Binding Percent}" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding CanRoll}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OnAccentSoft}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- History: what was spent, and each click with a way back to before it. -->
              <StackPanel Margin="14,12,14,14" Visibility="{Binding IsHistoryTab, Converter={StaticResource Vis}}">
                <Border Background="#1A1712" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8">
                  <WrapPanel>
                    <TextBlock Text="Spent" Style="{StaticResource Heading}" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <v:ValueLabel Text="{Binding Spent}" Tier="{Binding SpentTier}" Size="Medium" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding SpentNote}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                  </WrapPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding History}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="History">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                      <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextFaint}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" FontSize="13.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" LineHeight="18" />
                          </StackPanel>
                          <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="go back" MinHeight="28" FontSize="13" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Top"
                                  Command="{Binding Back}" CommandParameter="{Binding Number}" AutomationProperties.Name="{Binding BackName}" ToolTip="Go back to just before this step" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No clicks yet." Style="{StaticResource Faint}" FontSize="15" Margin="0,8,0,0" Visibility="{Binding NoHistory, Converter={StaticResource Vis}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <!-- The orb in hand follows the cursor, as in the game. Never hit-tested: clicks go to what is under it. -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="HeldIcon" Visibility="Collapsed">
        <v:CurrencyIcon Currency="{Binding HeldPicture}" Width="44" Height="44" />
      </Border>
    </Canvas>
  </Grid>
</UserControl>
