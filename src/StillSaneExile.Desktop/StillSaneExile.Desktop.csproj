<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StillSaneExile</AssemblyName>
    <RootNamespace>StillSaneExile.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sse.ico</ApplicationIcon>
    <!-- The stash picture collector calls Direct3D 11 and Windows.Graphics.Capture through COM vtables
         (Infrastructure\CaptureInterop.cs) instead of the 25 MB WinRT projection. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>StillSaneExile.Desktop.Program</StartupObject>
    <Title>Still Sane, Exile?</Title>
    <Description>Path of Exile 2 companion: item roll bars, price evidence and (later) stash, crafting, wealth and campaign guidance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StillSaneExile.Domain\StillSaneExile.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixtures\poeninja and fixtures\trade hold test answers shaped like poe.ninja's and the trade site's;
         the app never reads them, so they don't ship. -->
    <Content Include="..\..\fixtures\**\*" Exclude="..\..\fixtures\poeninja\**;..\..\fixtures\trade\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\sse.ico" />
    <!-- "What's new" shows this build's own changelog sections, so it works offline and covers skipped versions. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

</Project>
